  <script>
    import { Store } from "@tauri-apps/plugin-store"
    import { log } from "@/scripts/lib/log.js"
    import { t } from "@/scripts/lib/i18n.js"
    import { ICON_CHECK } from "@/scripts/lib/icons.ts"
    import {
      getActiveEntry,
      getEntries,
      refreshActive,
      isTauri,
      loadCreds,
    } from "@/scripts/lib/creds.js"
    import {
      getNewestCacheTimeAsync,
      getCacheSizeAsync,
      clearAll as clearAllCache,
      hydrate as hydrateCache,
    } from "@/scripts/lib/cache.js"
    import {
      renderPlaylistRow,
      getPlaylistListEmptyCopy,
    } from "@/scripts/lib/playlist-rows.js"
    import { injectVersion } from "@/scripts/version.js"
    import { fetchReleases, renderMarkdown } from "@/scripts/lib/changelog.ts"
    import {
      checkForUpdate,
