---
import Layout from "@/layouts/Layout.astro"
import {
  IconRefresh,
  IconTrash,
  IconAlertTriangle,
  IconPlus,
  IconFolderOpen,
  IconCloudDownload,
  IconBrandGithub,
  IconDeviceFloppy,
  IconDownload,
  IconUpload,
  IconHeart,
  IconCoffee,
  IconBrandPaypal,
  IconBug,
  IconMail,
  IconChevronDown,
  IconWorld,
  IconPalette,
  IconLayoutSidebar,
  IconWifi,
  IconFilter,
  IconStar,
  IconArchive,
  IconFileZip,
  IconDatabase,
  IconBrandDiscord,
  IconInfoCircle,
  IconSparkles,
  IconBolt,
  IconPlayerPlay,
  IconBook,
  IconRocket,
  IconLayoutDashboard,
  IconSearch,
  IconX,
  IconShare,
  IconExternalLink,
  IconRestore,
  IconLicense,
  IconMovie,
  IconEye,
  IconEyeOff,
  IconActivity,
} from "@tabler/icons-svelte"
import HiddenCategoriesEditor from "@/components/HiddenCategoriesEditor.svelte"
import LocalePicker from "@/components/LocalePicker.svelte"
import FavoritesReorder from "@/components/FavoritesReorder.svelte"
import HubStripsEditor from "@/components/HubStripsEditor.svelte"
import PlayerPicker from "@/components/PlayerPicker.svelte"
import TvOverscanCard from "@/components/TvOverscanCard.svelte"
import CloseToTrayCard from "@/components/CloseToTrayCard.svelte"
import ConnectionLimitBanner from "@/components/ConnectionLimitBanner.svelte"
import AndroidNativePlayerCard from "@/components/AndroidNativePlayerCard.svelte"
import RememberedAndroidPlayerCard from "@/components/RememberedAndroidPlayerCard.svelte"

interface NavCard { id: string; labelKey: string; label: string; conditional?: boolean }
interface NavSection { id: string; labelKey: string; label: string; cards: NavCard[]; danger?: boolean }

const navStructure: NavSection[] = [
  { id: "settings-playlists", labelKey: "settings.group.playlists", label: "Playlists", cards: [] },
  { id: "settings-appearance", labelKey: "settings.group.appearance", label: "Appearance", cards: [
    { id: "card-display",    labelKey: "settings.section.display",     label: "Display" },
    { id: "card-behavior",   labelKey: "settings.appearance.behavior", label: "Behavior" },
    { id: "card-hub-strips", labelKey: "settings.hubStrips.title",     label: "Home page sections" },
  ]},
  { id: "settings-watching", labelKey: "settings.group.watching", label: "Watching", cards: [
    { id: "card-livetv",      labelKey: "nav.livetv",             label: "Live TV" },
    { id: "playback-section", labelKey: "settings.playback.title", label: "Playback" },
  ]},
  { id: "settings-network", labelKey: "settings.group.network", label: "Network", cards: [
    { id: "card-network",          labelKey: "settings.network.title", label: "Network" },
    { id: "discord-rpc-section",   labelKey: "settings.discord.title", label: "Discord Rich Presence", conditional: true },
    { id: "card-tmdb",             labelKey: "settings.tmdb.title",    label: "TMDb metadata" },
    { id: "card-net-log",          labelKey: "settings.netLog.title",  label: "Network log", conditional: true },
  ]},
  { id: "settings-library", labelKey: "settings.group.library", label: "Library", cards: [
    { id: "card-categories", labelKey: "settings.categories.title",        label: "Categories" },
    { id: "card-favorites",  labelKey: "settings.favoritesSection.title",  label: "Favorites" },
  ]},
  { id: "settings-data", labelKey: "settings.group.data", label: "Data", cards: [
    { id: "downloads-folder-section", labelKey: "settings.downloadsSection.title", label: "Downloads" },
    { id: "card-backup",              labelKey: "settings.backup.title",           label: "Backup" },
    { id: "card-storage",             labelKey: "settings.storage.title",          label: "Storage" },
  ]},
  { id: "settings-about", labelKey: "settings.group.about", label: "About", cards: [
    { id: "update-section",    labelKey: "settings.nav.appUpdate",  label: "App update" },
    { id: "changelog-section", labelKey: "settings.about.whatsNew", label: "What's new" },
    { id: "licenses-section",  labelKey: "settings.licenses.title", label: "Licenses and attribution" },
  ]},
  { id: "settings-help", labelKey: "settings.group.help", label: "Help & feedback", cards: [
    { id: "card-docs",        labelKey: "settings.help.docsTitle",  label: "Read the docs" },
    { id: "card-feedback",    labelKey: "settings.nav.feedback",    label: "Send feedback" },
    { id: "settings-support", labelKey: "settings.group.support",   label: "Support" },
  ]},
  { id: "settings-danger",  labelKey: "settings.group.dangerZone", label: "Danger zone", cards: [], danger: true },
]
---

<Layout pageTitle="Settings" showVersion={false}>
  <main class="flex-1 min-h-0 overflow-y-auto overflow-x-clip custom-scroll">
    <div
      class="w-full max-w-480 mx-auto px-4 md:px-6 lg:px-8 pt-4 lg:pt-6 pb-12 flex flex-col gap-6 lg:gap-8">

    <header class="route-hero shrink-0">
      <h1 data-i18n="settings.title" class="route-hero__title">Settings</h1>
      <p data-i18n="page.settings.sub" class="route-hero__sub">
        Playlists, preferences, cache, and the app itself.
      </p>
    </header>

    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-10">

    <div class="settings-nav-scroller -mx-4 sm:-mx-6 lg:m-0 lg:contents">
    <nav
      aria-label="Settings sections"
      data-i18n-attr="aria-label:settings.nav.aria"
      class="settings-nav
        flex flex-row gap-1 px-4 sm:px-6 w-max
        lg:flex-col lg:gap-0.5 lg:px-0 lg:py-1 lg:w-52
        lg:sticky lg:top-6 lg:self-start">
      {navStructure.map((section) => (
        <Fragment>
          <a
            href={`#${section.id}`}
            data-i18n={section.labelKey}
            class="settings-nav-link"
            {...(section.danger ? { "data-danger": "true" } : {})}>
            {section.label}
          </a>
          {section.cards.length > 1 && (
            <ul class="settings-subnav hidden lg:flex flex-col list-none m-0 p-0">
              {section.cards.map((card) => (
                <li class="m-0" {...(card.conditional ? { "data-conditional": "true", hidden: true } : {})}>
                  <a
                    href={`#${card.id}`}
                    data-i18n={card.labelKey}
                    class="settings-subnav-link">
                    {card.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </Fragment>
      ))}
    </nav>
    </div>

    <div class="settings-stack flex-1 min-w-0">

    <div class="lg:sticky lg:top-0 lg:z-10 -mt-2 pt-2 pb-3">
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-fg-3 pointer-events-none inline-flex">
          <IconSearch aria-hidden="true" stroke={2} size={16} />
        </span>
        <input
          id="settings-search-input"
          type="search"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="search"
          data-i18n-attr="placeholder:settings.search.placeholder;aria-label:settings.search.placeholder"
          placeholder="Search settings"
          class="w-full h-11 rounded-xl border border-accent bg-surface text-fg
            pl-10 pr-11 text-sm placeholder:text-fg-3
            focus-visible:border-accent outline-none
            transition-colors"
        />
        <button
          id="settings-search-clear"
          type="button"
          data-i18n-attr="aria-label:settings.search.clear"
          aria-label="Clear search"
          class="absolute right-1 top-1/2 -translate-y-1/2 size-9 rounded-md
            text-fg-3 hover:text-fg hover:bg-surface-2
            focus-visible:text-fg focus-visible:bg-surface-2
            inline-flex items-center justify-center transition-colors"
          hidden>
          <IconX aria-hidden="true" stroke={2} size={16} />
        </button>
      </div>
      <p
        id="settings-search-empty"
        data-i18n="settings.search.noMatches"
        class="mt-3 text-sm text-fg-3 px-1"
        role="status"
        aria-live="polite"
        hidden>
        No settings match your search.
      </p>
    </div>

    <!-- Group: Playlists -->
    <section id="settings-playlists" class="settings-group scroll-mt-8 lg:scroll-mt-20">
      <h2 data-i18n="settings.group.playlists" class="settings-group__title">Playlists</h2>
      <div class="rounded-2xl border border-line bg-surface p-5 sm:p-6 flex flex-col gap-4">
        <div
          id="settings-playlists-list"
          class="flex flex-col divide-y divide-line/60 rounded-xl border border-line bg-bg overflow-hidden">
          <div data-i18n="settings.playlists.empty" class="px-4 py-4 text-xs text-fg-3">No playlists yet.</div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
          <a href="/login" class="btn justify-start sm:justify-center">
            <IconPlus aria-hidden="true" class="btn-icon" />
            <span data-i18n="playlist.add">Add playlist</span>
          </a>
          <button
            id="settings-refresh-active"
            type="button"
            class="btn justify-start sm:justify-center hidden">
            <IconRefresh aria-hidden="true" class="btn-icon" />
            <span data-i18n="playlist.refreshActive">Refresh active</span>
          </button>
          <button
            id="settings-add-from-website"
            type="button"
            class="btn justify-start sm:justify-center hidden">
            <IconWorld aria-hidden="true" class="btn-icon" />
            <span data-i18n="settings.playlists.addFromWebsite">Add from website</span>
          </button>
          <button
            id="settings-new-custom-playlist"
            type="button"
            class="btn justify-start sm:justify-center">
            <IconPlus aria-hidden="true" class="btn-icon" />
            <span data-i18n="editor.newCustomPlaylistBtn">New custom playlist</span>
          </button>
        </div>
      </div>
    </section>

    <!-- New custom playlist dialog -->
    <dialog
      id="settings-new-custom-playlist-dialog"
      aria-labelledby="settings-new-custom-playlist-title"
      class="fixed inset-0 m-auto rounded-2xl border border-line bg-surface text-fg p-0
             w-[min(24rem,calc(100vw-2rem))] backdrop:bg-black/60">
      <form method="dialog" class="flex flex-col gap-4 p-5">
        <h2 id="settings-new-custom-playlist-title" data-i18n="editor.newPlaylistDialogTitle" class="text-base font-semibold">
          New custom playlist
        </h2>
        <label class="flex flex-col gap-1.5">
          <span data-i18n="editor.newPlaylistNameLabel" class="text-xs font-semibold uppercase tracking-wider text-fg-3">
            Playlist name
          </span>
          <input
            id="settings-new-custom-playlist-name"
            type="text"
            class="field-input"
            data-i18n-attr="placeholder:editor.newPlaylistNamePlaceholder"
            placeholder="My playlist"
          />
        </label>
        <div class="flex gap-2 justify-end">
          <button type="button" data-role="cancel" class="btn">
            <span data-i18n="common.cancel">Cancel</span>
          </button>
          <button type="submit" data-role="create" class="btn-primary">
            <span data-i18n="editor.newPlaylistCreate">Create</span>
          </button>
        </div>
      </form>
    </dialog>

    <!-- Group: Appearance (language, theme/font, perf mode, home page sections, close behavior) -->
    <section id="settings-appearance" class="settings-group scroll-mt-8 lg:scroll-mt-20">
      <h2 data-i18n="settings.group.appearance" class="settings-group__title">Appearance</h2>
      <div class="flex flex-col gap-4">

        <!-- Surface: Display -->
        <div id="card-display" class="settings-surface icon-mark-host scroll-mt-6 lg:scroll-mt-20">
          <div class="settings-surface__header">
            <span class="icon-mark">
              <IconPalette aria-hidden="true" stroke={2} />
            </span>
            <h3 data-i18n="settings.section.display" class="text-base font-semibold">Display</h3>
          </div>
          <div class="settings-rows">

            <!-- Language -->
            <div id="card-language" data-settings-item class="settings-row scroll-mt-6 lg:scroll-mt-20">
              <div class="settings-row__text">
                <h3 data-i18n="settings.section.language" class="text-sm font-medium leading-snug">Language</h3>
                <p data-i18n="settings.language.cardHelper" class="text-xs text-fg-3">
                  Pick a language for the interface. Translations are community-driven - missing strings fall back to English.
                </p>
              </div>
              <div class="settings-row__control w-full @2xl:w-64">
                <LocalePicker client:load />
              </div>
            </div>

            <!-- Theme + accent + font scale -->
            <div data-settings-item class="scroll-mt-6 lg:scroll-mt-20 settings-rows">
              <div class="settings-row">
                <span data-i18n="settings.theme.label" class="text-sm font-medium leading-snug">Theme</span>
                <div class="settings-row__control">
                  <div
                    id="settings-theme"
                    class="settings-seg"
                    role="radiogroup"
                    data-i18n-attr="aria-label:settings.theme.label"
                    aria-label="Theme">
                    <button type="button" role="radio" data-theme="system" aria-checked="false" data-i18n="settings.theme.system" class="theme-btn btn">System</button>
                    <button type="button" role="radio" data-theme="light"  aria-checked="false" data-i18n="settings.theme.light" class="theme-btn btn">Light</button>
                    <button type="button" role="radio" data-theme="dark"   aria-checked="false" data-i18n="settings.theme.dark" class="theme-btn btn">Dark</button>
                  </div>
                </div>
              </div>

              <div class="settings-row">
                <div class="settings-row__text">
                  <span data-i18n="settings.accent.label" class="text-sm font-medium leading-snug">Accent color</span>
                </div>
                <div class="settings-row__control">
                <div class="flex flex-col items-end gap-2">
                  <div
                    id="settings-accent"
                    class="flex flex-wrap justify-end gap-2"
                    role="radiogroup"
                    data-i18n-attr="aria-label:settings.accent.label"
                    aria-label="Accent color">
                    <button type="button" role="radio" data-accent-value="fuchsia" aria-checked="false" data-i18n-attr="title:settings.accent.fuchsia;aria-label:settings.accent.fuchsia" title="Fuchsia" aria-label="Fuchsia" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-fuchsia)">
                      <span class="size-5 rounded-full bg-(--swatch) group-aria-checked:ring-2 group-aria-checked:ring-(--swatch) group-aria-checked:ring-offset-2 group-aria-checked:ring-offset-surface" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="radio" data-accent-value="rose" aria-checked="false" data-i18n-attr="title:settings.accent.rose;aria-label:settings.accent.rose" title="Rose" aria-label="Rose" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-rose)">
                      <span class="size-5 rounded-full bg-(--swatch) group-aria-checked:ring-2 group-aria-checked:ring-(--swatch) group-aria-checked:ring-offset-2 group-aria-checked:ring-offset-surface" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="radio" data-accent-value="ember" aria-checked="false" data-i18n-attr="title:settings.accent.ember;aria-label:settings.accent.ember" title="Ember" aria-label="Ember" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-ember)">
                      <span class="size-5 rounded-full bg-(--swatch) group-aria-checked:ring-2 group-aria-checked:ring-(--swatch) group-aria-checked:ring-offset-2 group-aria-checked:ring-offset-surface" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="radio" data-accent-value="emerald" aria-checked="false" data-i18n-attr="title:settings.accent.emerald;aria-label:settings.accent.emerald" title="Emerald" aria-label="Emerald" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-emerald)">
                      <span class="size-5 rounded-full bg-(--swatch) group-aria-checked:ring-2 group-aria-checked:ring-(--swatch) group-aria-checked:ring-offset-2 group-aria-checked:ring-offset-surface" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="radio" data-accent-value="cyan" aria-checked="false" data-i18n-attr="title:settings.accent.cyan;aria-label:settings.accent.cyan" title="Cyan" aria-label="Cyan" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-cyan)">
                      <span class="size-5 rounded-full bg-(--swatch) group-aria-checked:ring-2 group-aria-checked:ring-(--swatch) group-aria-checked:ring-offset-2 group-aria-checked:ring-offset-surface" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="radio" data-accent-value="blue" aria-checked="false" data-i18n-attr="title:settings.accent.blue;aria-label:settings.accent.blue" title="Blue" aria-label="Blue" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-blue)">
                      <span class="size-5 rounded-full bg-(--swatch) group-aria-checked:ring-2 group-aria-checked:ring-(--swatch) group-aria-checked:ring-offset-2 group-aria-checked:ring-offset-surface" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="radio" data-accent-value="violet" aria-checked="false" data-i18n-attr="title:settings.accent.violet;aria-label:settings.accent.violet" title="Violet" aria-label="Violet" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-violet)">
                      <span class="size-5 rounded-full bg-(--swatch) group-aria-checked:ring-2 group-aria-checked:ring-(--swatch) group-aria-checked:ring-offset-2 group-aria-checked:ring-offset-surface" aria-hidden="true"></span>
                    </button>
                  </div>
                  <p id="settings-accent-override-hint" data-i18n="settings.accent.overrideHint" class="hidden text-xs text-fg-3 text-right">
                    The active playlist overrides this color.
                  </p>
                </div>
                </div>
              </div>

              <div class="settings-row">
                <div class="settings-row__text">
                  <span data-i18n="settings.fontScale.label" class="text-sm font-medium leading-snug">Font scale</span>
                  <p data-i18n="settings.fontScale.helper" class="text-xs text-fg-3">
                    Bumps the base font size. Use Large or X-Large when viewing on a TV from across the room.
                  </p>
                </div>
                <div class="settings-row__control">
                  <div
                    id="settings-font-scale"
                    class="settings-seg"
                    role="radiogroup"
                    data-i18n-attr="aria-label:settings.fontScale.label"
                    aria-label="Font scale">
                    <button type="button" data-scale="0.875" aria-pressed="false" data-i18n="settings.fontScale.small" class="font-scale-btn btn">Small</button>
                    <button type="button" data-scale="1"     aria-pressed="false" data-i18n="settings.fontScale.default" class="font-scale-btn btn">Default</button>
                    <button type="button" data-scale="1.125" aria-pressed="false" data-i18n="settings.fontScale.medium" class="font-scale-btn btn">Medium</button>
                    <button type="button" data-scale="1.25"  aria-pressed="false" data-i18n="settings.fontScale.large" class="font-scale-btn btn">Large</button>
                    <button type="button" data-scale="1.5"   aria-pressed="false" data-i18n="settings.fontScale.xlarge" class="font-scale-btn btn">X-Large</button>
                  </div>
                </div>
              </div>

              <div class="settings-row">
                <div class="settings-row__text">
                  <span data-i18n="settings.density.label" class="text-sm font-medium leading-snug">Density</span>
                  <p data-i18n="settings.density.helper" class="text-xs text-fg-3">
                    Tightens or loosens spacing in lists and menus. Independent of font scale.
                  </p>
                </div>
                <div class="settings-row__control">
                  <div
                    id="settings-density"
                    class="settings-seg"
                    role="radiogroup"
                    data-i18n-attr="aria-label:settings.density.label"
                    aria-label="Density">
                    <button type="button" data-density="compact"     aria-pressed="false" data-i18n="settings.density.compact" class="density-btn btn">Compact</button>
                    <button type="button" data-density="cozy"        aria-pressed="false" data-i18n="settings.density.cozy" class="density-btn btn">Cozy</button>
                    <button type="button" data-density="comfortable" aria-pressed="false" data-i18n="settings.density.comfortable" class="density-btn btn">Comfortable</button>
                  </div>
                </div>
              </div>
              <script is:inline>
                try {
                  var savedFontScale = parseFloat(localStorage.getItem("xt_font_scale") || "1");
                  if (!isFinite(savedFontScale) || savedFontScale < 0.75 || savedFontScale > 2) savedFontScale = 1;
                  var fontScaleGroup = document.getElementById("settings-font-scale");
                  if (fontScaleGroup) {
                    var fontScaleBtns = fontScaleGroup.querySelectorAll(".font-scale-btn");
                    for (var i = 0; i < fontScaleBtns.length; i++) {
                      var btnScale = parseFloat(fontScaleBtns[i].getAttribute("data-scale") || "1");
                      fontScaleBtns[i].setAttribute("aria-pressed", Math.abs(btnScale - savedFontScale) < 0.001 ? "true" : "false");
                    }
                  }
                  var savedDensity = localStorage.getItem("xt_density") || "cozy";
                  if (savedDensity !== "compact" && savedDensity !== "cozy" && savedDensity !== "comfortable") savedDensity = "cozy";
                  var densityGroup = document.getElementById("settings-density");
                  if (densityGroup) {
                    var densityBtns = densityGroup.querySelectorAll(".density-btn");
                    for (var densityIndex = 0; densityIndex < densityBtns.length; densityIndex++) {
                      densityBtns[densityIndex].setAttribute("aria-pressed", densityBtns[densityIndex].getAttribute("data-density") === savedDensity ? "true" : "false");
                    }
                  }
                  var currentTheme = localStorage.getItem("xt_theme") || "system";
                  var themeGroup = document.getElementById("settings-theme");
                  if (themeGroup) {
                    var themeBtns = themeGroup.querySelectorAll(".theme-btn");
                    for (var j = 0; j < themeBtns.length; j++) {
                      themeBtns[j].setAttribute("aria-checked", themeBtns[j].getAttribute("data-theme") === currentTheme ? "true" : "false");
                    }
                  }
                  var currentAccent = localStorage.getItem("xt_accent") || "fuchsia";
                  var accentGroup = document.getElementById("settings-accent");
                  if (accentGroup) {
                    var accentBtns = accentGroup.querySelectorAll(".accent-btn");
                    for (var k = 0; k < accentBtns.length; k++) {
                      accentBtns[k].setAttribute("aria-checked", accentBtns[k].getAttribute("data-accent-value") === currentAccent ? "true" : "false");
                    }
                  }
                } catch (e) {}
              </script>
            </div>

            <!-- Performance mode: skip decorative animations + focus-glide for low-end TV WebViews -->
            <div id="card-perf-mode" data-settings-item class="settings-row scroll-mt-6 lg:scroll-mt-20">
              <div class="settings-row__text">
                <h3 data-i18n="settings.perfMode.title" class="text-sm font-medium leading-snug">Performance mode</h3>
                <p data-i18n="settings.perfMode.helperLong" class="text-xs text-fg-3">
                  Disables decorative animations (the comet in the sidebar, hub entry stagger, sliding focus ring) for smoother scrolling and D-pad navigation on TV boxes and low-end devices.
                </p>
              </div>
              <div class="settings-row__control">
                <div
                  id="settings-perf-mode"
                  class="settings-seg shrink-0"
                  role="radiogroup"
                  aria-label="Performance mode"
                  data-i18n-attr="aria-label:settings.perfMode.label">
                  <button type="button" data-perf="on"  aria-pressed="false" data-i18n="settings.perfMode.on"  class="perf-mode-btn btn">On</button>
                  <button type="button" data-perf="off" aria-pressed="false" data-i18n="settings.perfMode.off" class="perf-mode-btn btn">Off</button>
                </div>
              </div>
              <script is:inline>
                try {
                  var perfOn = localStorage.getItem("xt_perf_mode") === "1";
                  var perfGroup = document.getElementById("settings-perf-mode");
                  if (perfGroup) {
                    var perfBtns = perfGroup.querySelectorAll(".perf-mode-btn");
