    <!-- Group: Network (User-Agent spoofing, Discord Rich Presence) -->
    <section id="settings-network" class="settings-group scroll-mt-8 lg:scroll-mt-20">
      <h2 data-i18n="settings.group.network" class="settings-group__title">Network</h2>
      <div class="flex flex-col gap-4">

        <!-- Surface: Network -->
        <div id="card-network" data-settings-item class="settings-surface icon-mark-host scroll-mt-6 lg:scroll-mt-20">
          <div class="settings-surface__header">
            <span class="icon-mark">
              <IconWifi aria-hidden="true" stroke={2} />
            </span>
            <h3 data-i18n="settings.network.title" class="text-base font-semibold">Network</h3>
          </div>
          <div class="settings-rows">

            <!-- User agent preset -->
            <div data-settings-item class="settings-row scroll-mt-6 lg:scroll-mt-20">
              <div class="settings-row__text">
                <h3 data-i18n="settings.network.uaPreset" class="text-sm font-medium leading-snug">User-Agent preset</h3>
                <p data-i18n="settings.network.helperLong" class="text-xs text-fg-3">
                  Some IPTV providers reject the default browser User-Agent. Pick a preset or enter a custom string. Applies to provider API, M3U, and EPG fetches. Effective in the desktop build.
                </p>
              </div>
              <div class="settings-row__control w-full @2xl:w-72">
                <select
                  id="ua-preset"
                  class="field-input"
                  data-i18n-attr="aria-label:settings.network.uaPreset"
                  aria-label="User-Agent preset"></select>
              </div>
            </div>

            <!-- User agent custom override -->
            <div data-settings-item class="settings-row settings-row--stack scroll-mt-6 lg:scroll-mt-20">
              <div class="settings-row__text">
                <h3 data-i18n="settings.network.uaCustom" class="text-sm font-medium leading-snug">Custom (overrides preset)</h3>
              </div>
              <div class="settings-row__control w-full flex-col items-stretch gap-1">
                <div class="flex gap-2">
                  <input
                    id="ua-custom"
                    type="text"
                    autocomplete="off"
                    spellcheck="false"
                    placeholder="e.g. VLC/3.0.20 LibVLC/3.0.20"
                    data-i18n-attr="placeholder:settings.network.uaPlaceholder"
                    class="field-input font-mono flex-1 min-w-0"
                  />
                  <button id="ua-save" type="button" class="btn justify-center">
                    <IconDeviceFloppy aria-hidden="true" class="btn-icon" />
                    <span data-i18n="common.save">Save</span>
                  </button>
                </div>
                <span
                  id="ua-msg"
                  aria-live="polite"
                  class="text-xs text-fg-3 transition-opacity duration-300 empty:hidden"></span>
              </div>
            </div>

            <!-- Request timeout -->
            <div data-settings-item class="settings-row scroll-mt-6 lg:scroll-mt-20">
              <div class="settings-row__text">
                <h3 data-i18n="settings.network.timeoutLabel" class="text-sm font-medium leading-snug">Request timeout</h3>
                <p id="settings-network-timeout-helper" data-i18n="settings.network.timeoutHelper" class="text-xs text-fg-3">
                  How long to wait for a provider response before giving up. Bump this when a large catalog (tens of thousands of movies / series) times out before it finishes loading.
                </p>
              </div>
              <div class="settings-row__control">
                <div
                  id="settings-network-timeout"
                  class="settings-seg"
                  role="radiogroup"
                  aria-label="Request timeout"
                  aria-describedby="settings-network-timeout-helper"
                  data-i18n-attr="aria-label:settings.network.timeoutLabel">
                  <button type="button" role="radio" data-timeout="20"  aria-checked="false" data-i18n="settings.network.timeout.20s"  class="net-timeout-btn btn">20s</button>
                  <button type="button" role="radio" data-timeout="45"  aria-checked="false" data-i18n="settings.network.timeout.45s"  class="net-timeout-btn btn">45s</button>
                  <button type="button" role="radio" data-timeout="90"  aria-checked="false" data-i18n="settings.network.timeout.90s"  class="net-timeout-btn btn">90s</button>
                  <button type="button" role="radio" data-timeout="180" aria-checked="false" data-i18n="settings.network.timeout.180s" class="net-timeout-btn btn">3 min</button>
                </div>
              </div>
            </div>

            <!-- Developer mode: unlocks the network log card below -->
            <div data-settings-item class="settings-row scroll-mt-6 lg:scroll-mt-20">
              <div class="settings-row__text">
                <h3 data-i18n="settings.devMode.title" class="text-sm font-medium leading-snug">Developer mode</h3>
                <p id="settings-dev-mode-helper" data-i18n="settings.devMode.helperLong" class="text-xs text-fg-3">
                  Unlocks a network log of recent provider requests, useful when troubleshooting a connection issue. Off by default.
                </p>
              </div>
              <div class="settings-row__control">
                <div
                  id="settings-dev-mode"
                  class="settings-seg"
                  role="radiogroup"
                  aria-label="Developer mode"
                  aria-describedby="settings-dev-mode-helper"
                  data-i18n-attr="aria-label:settings.devMode.label">
                  <button type="button" role="radio" data-dev="on"  aria-checked="false" data-i18n="settings.devMode.on"  class="dev-mode-btn btn">On</button>
                  <button type="button" role="radio" data-dev="off" aria-checked="false" data-i18n="settings.devMode.off" class="dev-mode-btn btn">Off</button>
                </div>
              </div>
            </div>

            <!-- Discord Rich Presence: desktop-only, unhidden by the script below -->
            <details id="discord-rpc-section" data-settings-item class="hidden group scroll-mt-6 lg:scroll-mt-20">
              <summary class="settings-row cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
                <span class="settings-row__text">
                  <h3 class="text-sm font-medium leading-snug">
                    <IconBrandDiscord aria-hidden="true" stroke={2} class="size-4 text-fg-3 inline-block align-[-2px] me-1.5" />
                    <span data-i18n="settings.discord.title">Discord Rich Presence</span>
                  </h3>
                  <span data-i18n="settings.discord.helperLong" class="text-xs text-fg-3 line-clamp-1 block">
                    Show "Watching X on Extreme InfiniTV" on your Discord profile while you use the app. On by default; uncheck a playlist below to mute presence for that account. Desktop only - requires Discord running on the same machine.
                  </span>
                </span>
                <span class="settings-row__control">
                  <IconChevronDown aria-hidden="true" stroke={2} class="size-4 text-fg-3 transition-transform group-open:rotate-180" />
                </span>
              </summary>
              <div class="px-5 sm:px-6 pb-4 pt-1 flex flex-col gap-3">
                <input id="discord-client-id" type="hidden" />

                <div id="discord-controls" class="flex flex-col gap-2">
                  <span data-i18n="settings.discord.perPlaylist" class="text-eyebrow font-medium uppercase text-fg-3">Per-playlist</span>
                  <div
                    id="discord-playlists"
                    class="flex flex-col divide-y divide-line/60 rounded-xl border border-line bg-bg overflow-hidden">
                    <div data-i18n="settings.playlists.empty" class="px-4 py-4 text-xs text-fg-3">No playlists yet.</div>
                  </div>
                </div>
                <p id="discord-sandbox-note" data-i18n="settings.discord.sandboxNote" class="text-xs text-fg-3" hidden>
                  Discord Rich Presence isn't available in Snap installs.
                </p>
              </div>
            </details>

          </div>
        </div>

        <!-- Surface: TMDb metadata enrichment -->
        <div id="card-tmdb" data-settings-item class="settings-surface icon-mark-host scroll-mt-6 lg:scroll-mt-20">
          <div class="settings-surface__header">
            <span class="icon-mark">
              <IconMovie aria-hidden="true" stroke={2} />
            </span>
            <h3 data-i18n="settings.tmdb.title" class="text-base font-semibold">TMDb metadata</h3>
          </div>
          <p data-i18n="settings.tmdb.helper" class="settings-surface__helper text-xs text-fg-3">
            Enrich movies and series with better posters, cast, trailers, and similar titles from The Movie Database.
          </p>
          <div class="settings-rows">

            <!-- Enable enrichment -->
            <div data-settings-item class="settings-row scroll-mt-6 lg:scroll-mt-20">
              <div class="settings-row__text">
                <h3 data-i18n="settings.tmdb.enable" class="text-sm font-medium leading-snug">Enable enrichment</h3>
                <p data-i18n="settings.tmdb.privacy" class="text-xs text-fg-3">
                  When enabled, the titles you open are sent to TMDB for matching.
                </p>
              </div>
              <div class="settings-row__control">
                <div
                  id="settings-tmdb-enabled"
                  class="settings-seg"
                  role="radiogroup"
                  aria-label="Enable enrichment"
                  data-i18n-attr="aria-label:settings.tmdb.enable">
                  <button type="button" data-tmdb="on"  aria-pressed="false" data-i18n="settings.tmdb.on"  class="tmdb-enabled-btn btn">On</button>
                  <button type="button" data-tmdb="off" aria-pressed="false" data-i18n="settings.tmdb.off" class="tmdb-enabled-btn btn">Off</button>
                </div>
              </div>
              <script is:inline>
                try {
                  var tmdbEnabledRaw = localStorage.getItem("xt_tmdb_enabled");
                  var tmdbEnabledOn = tmdbEnabledRaw === "1";
                  var tmdbEnabledGroup = document.getElementById("settings-tmdb-enabled");
                  if (tmdbEnabledGroup) {
                    var tmdbEnabledBtns = tmdbEnabledGroup.querySelectorAll(".tmdb-enabled-btn");
                    for (var tIdx = 0; tIdx < tmdbEnabledBtns.length; tIdx++) {
                      var tmdbEnabledBtnOn = tmdbEnabledBtns[tIdx].getAttribute("data-tmdb") === "on";
                      tmdbEnabledBtns[tIdx].setAttribute("aria-pressed", tmdbEnabledBtnOn === tmdbEnabledOn ? "true" : "false");
                    }
                  }
                } catch (e) {}
              </script>
            </div>

            <!-- API key -->
            <div data-settings-item class="settings-row scroll-mt-6 lg:scroll-mt-20">
              <div class="settings-row__text">
                <h3 data-i18n="settings.tmdb.apiKey" class="text-sm font-medium leading-snug">API key</h3>
                <p class="text-xs text-fg-3">
                  <span data-i18n="settings.tmdb.apiKeyHelper">Paste a free TMDB API key or v4 access token.</span>
                  <a
                    href="https://www.themoviedb.org/settings/api"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-external
                    data-i18n="settings.tmdb.getKey"
                    class="text-accent underline ms-1">Get a key at themoviedb.org</a>
                </p>
              </div>
              <div class="settings-row__control w-full @2xl:w-96 flex-col items-stretch gap-1">
                <div class="flex gap-2">
                  <input
                    id="settings-tmdb-key"
                    type="password"
                    autocomplete="off"
                    spellcheck="false"
                    class="field-input font-mono flex-1 min-w-0"
                  />
                  <button
                    id="settings-tmdb-reveal"
                    type="button"
                    class="btn flex-none w-11 justify-center p-0"
                    aria-label="Show key"
                    data-i18n-attr="aria-label:settings.tmdb.reveal">
                    <IconEye aria-hidden="true" class="btn-icon" data-tmdb-reveal-icon="show" />
                    <IconEyeOff aria-hidden="true" class="btn-icon hidden" data-tmdb-reveal-icon="hide" />
                  </button>
                  <button id="settings-tmdb-test" type="button" class="btn flex-none w-auto justify-center">
                    <span data-i18n="settings.tmdb.test">Test key</span>
                  </button>
                </div>
                <span
                  id="settings-tmdb-msg"
                  aria-live="polite"
                  class="text-xs text-fg-3 transition-opacity duration-300 empty:hidden"></span>
              </div>
            </div>

          </div>
          <p class="text-2xs text-fg-3 px-5 sm:px-6 pb-5 sm:pb-6 -mt-1">
            This product uses the TMDB API but is not endorsed or certified by TMDB.
          </p>
        </div>

        <!-- Network log: developer-mode only, unhidden by the script below -->
        <details id="card-net-log" data-settings-item class="changelog-outer settings-surface icon-mark-host group hidden scroll-mt-6 lg:scroll-mt-20">
          <summary class="settings-surface__header cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden pb-5 sm:pb-6">
            <span class="icon-mark">
              <IconActivity aria-hidden="true" stroke={2} />
            </span>
            <h3 data-i18n="settings.netLog.title" class="text-base font-semibold">Network log</h3>
            <span class="ms-auto shrink-0">
              <IconChevronDown
                aria-hidden="true"
                stroke={1.75}
                class="size-4 text-fg-3 shrink-0 changelog-chevron transition-transform duration-200" />
            </span>
          </summary>
          <div class="flex flex-col gap-3 px-5 sm:px-6 pb-5 sm:pb-6 pt-4 sm:pt-5 border-t border-line/60">

            <p data-i18n="settings.netLog.helper" class="text-xs text-fg-3">
              Recent provider requests, with credentials stripped. Kept for this app session only and cleared when you close the app.
            </p>

            <div class="flex flex-wrap items-center gap-2">
              <button id="net-log-clear" type="button" class="btn">
                <IconTrash aria-hidden="true" class="btn-icon" />
                <span data-i18n="settings.netLog.clear">Clear</span>
              </button>
              <select
                id="net-log-kind-filter"
                class="field-input w-auto"
                data-i18n-attr="aria-label:settings.netLog.kindFilter"
                aria-label="Filter by kind">
                <option value="all" data-i18n="settings.netLog.kind.all">All kinds</option>
                <option value="api" data-i18n="settings.netLog.kind.api">API</option>
                <option value="playlist" data-i18n="settings.netLog.kind.playlist">Playlist</option>
                <option value="epg" data-i18n="settings.netLog.kind.epg">EPG</option>
                <option value="image" data-i18n="settings.netLog.kind.image">Image</option>
                <option value="media" data-i18n="settings.netLog.kind.media">Media</option>
                <option value="update" data-i18n="settings.netLog.kind.update">Update</option>
                <option value="other" data-i18n="settings.netLog.kind.other">Other</option>
              </select>
              <label class="inline-flex items-center gap-2 min-h-11 px-1 cursor-pointer">
                <input id="net-log-include-images" type="checkbox" class="size-4 accent-accent" />
                <span data-i18n="settings.netLog.includeImages" class="text-xs text-fg-2">Include image requests</span>
              </label>
              <button id="net-log-copy" type="button" class="btn ms-auto">
                <IconDeviceFloppy aria-hidden="true" class="btn-icon" />
                <span data-i18n="settings.netLog.copyJson">Copy as JSON</span>
              </button>
            </div>

            <div id="net-log-rows" class="flex flex-col divide-y divide-line/60 rounded-xl border border-line bg-bg overflow-hidden empty:hidden"></div>

            <div class="flex items-center justify-between gap-3 flex-wrap">
              <p id="net-log-count" class="text-2xs text-fg-3 tabular-nums"></p>
              <span
                id="net-log-msg"
                aria-live="polite"
                class="text-xs text-fg-3 transition-opacity duration-300 empty:hidden"></span>
            </div>

          </div>
        </details>

      </div>
    </section>

    <!-- Group: Library (per-playlist content curation: hidden categories, favorites order) -->
    <section id="settings-library" class="settings-group scroll-mt-8 lg:scroll-mt-20">
      <h2 data-i18n="settings.group.library" class="settings-group__title">Library</h2>
      <div class="flex flex-col gap-4">

        <!-- Hidden categories editor -->
        <details id="card-categories" data-settings-item class="settings-surface icon-mark-host group scroll-mt-6 lg:scroll-mt-20">
          <summary class="settings-surface__header flex-wrap pb-5 sm:pb-6 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-3 min-w-0 w-full">
              <span class="icon-mark">
                <IconFilter aria-hidden="true" stroke={2} />
              </span>
              <h3 data-i18n="settings.categories.title" class="text-base font-semibold">Categories</h3>
              <span class="ms-auto shrink-0">
                <IconChevronDown aria-hidden="true" stroke={2} class="size-4 text-fg-3 transition-transform group-open:rotate-180" />
              </span>
            </span>
            <span data-i18n="settings.categories.helperLong" class="text-xs text-fg-3 block mt-1.5">
              Per-playlist mute list. Hidden categories are hidden from
              the picker and the main grid on Live TV, Movies, and Series.
            </span>
          </summary>
          <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-1">
            <HiddenCategoriesEditor client:load />
          </div>
        </details>

        <!-- Favorites order -->
        <details id="card-favorites" data-settings-item class="settings-surface icon-mark-host group scroll-mt-6 lg:scroll-mt-20">
          <summary class="settings-surface__header flex-wrap pb-5 sm:pb-6 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-3 min-w-0 w-full">
              <span class="icon-mark">
                <IconStar aria-hidden="true" stroke={2} />
              </span>
              <h3 data-i18n="settings.favoritesSection.title" class="text-base font-semibold">Favorites</h3>
              <span class="ms-auto shrink-0">
                <IconChevronDown aria-hidden="true" stroke={2} class="size-4 text-fg-3 transition-transform group-open:rotate-180" />
              </span>
            </span>
            <span data-i18n="settings.favoritesSection.helperLong" class="text-xs text-fg-3 block mt-1.5">
              Reorder your favorites per kind. The hub Favorites strip and
              the per-page favorites filter follow this order.
            </span>
          </summary>
          <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-1">
            <FavoritesReorder client:load />
          </div>
        </details>

      </div>
    </section>

    <!-- Group: Data (downloads folder, backup, cache storage) -->
    <section id="settings-data" class="settings-group scroll-mt-8 lg:scroll-mt-20">
      <h2 data-i18n="settings.group.data" class="settings-group__title">Data</h2>
      <div class="flex flex-col gap-4">

        <!-- Surface: Downloads (folder only - queue lives on /downloads) -->
        <div id="downloads-folder-section" data-settings-item class="settings-surface icon-mark-host scroll-mt-6 lg:scroll-mt-20">
          <div class="settings-surface__header">
            <span class="icon-mark">
              <IconDownload aria-hidden="true" stroke={2} />
            </span>
            <h3 data-i18n="settings.downloadsSection.title" class="text-base font-semibold">Downloads</h3>
            <span id="downloads-availability" class="ms-auto text-xs text-fg-3 shrink-0 truncate empty:hidden"></span>
          </div>
          <div class="px-5 sm:px-6 pt-3 empty:pt-0">
            <ConnectionLimitBanner client:load />
          </div>
          <div class="settings-rows">

            <!-- Save to -->
            <div data-settings-item class="settings-row settings-row--stack scroll-mt-6 lg:scroll-mt-20">
              <div class="settings-row__text">
                <h3 data-i18n="settings.downloadsFolder.savedTo" class="text-sm font-medium leading-snug">Save to</h3>
                <p data-i18n-html="settings.downloadsFolder.intro" class="text-xs text-fg-3">
                  Folder where new downloads land. Manage the queue itself on the
                  <a href="/downloads" class="text-accent underline">Downloads page</a>.
                </p>
              </div>
              <div class="settings-row__control w-full flex-col items-stretch">
                <div class="flex gap-2 flex-wrap">
                  <input
                    id="download-dir-input"
                    type="text"
                    readonly
                    placeholder="Not set - picked on first download"
                    data-i18n-attr="placeholder:settings.downloadsFolder.notSetPlaceholder;aria-label:settings.downloadsFolder.savedTo"
                    aria-label="Save to"
                    class="field-input flex-1 min-w-0 font-mono"
                  />
                  <button id="download-dir-pick" type="button" class="btn">
                    <IconFolderOpen aria-hidden="true" class="btn-icon" />
                    <span data-i18n="settings.downloadsFolder.choose">Choose…</span>
                  </button>
                  <button id="download-dir-clear" type="button" class="btn text-fg-2">
                    <span data-i18n="common.clear">Clear</span>
                  </button>
                  <button id="settings-open-downloads" type="button" class="btn justify-center hidden">
                    <IconFolderOpen aria-hidden="true" class="btn-icon" />
                    <span data-i18n="downloads.action.openFolder">Open folder</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Restore from folder -->
            <div data-settings-item class="settings-row settings-row--stack scroll-mt-6 lg:scroll-mt-20">
              <div class="settings-row__text">
                <h3 data-i18n="settings.downloadsFolder.restoreLabel" class="text-sm font-medium leading-snug">Restore from folder</h3>
                <p data-i18n="settings.downloadsFolder.restoreHelper" class="text-xs text-fg-3">
                  After a reinstall, scan the folder above for `.xtmeta.json` sidecars and re-add the matching files to your downloads list.
                </p>
              </div>
              <div class="settings-row__control w-full flex-col items-stretch gap-1">
                <div class="flex">
                  <button id="downloads-scan" type="button" class="btn justify-start sm:justify-center">
                    <IconRefresh aria-hidden="true" class="btn-icon" />
                    <span data-i18n="settings.downloadsFolder.scanFolder">Scan folder</span>
                  </button>
                </div>
                <span
                  id="downloads-scan-msg"
                  aria-live="polite"
                  class="text-xs text-fg-3 transition-opacity duration-300 empty:hidden"></span>
              </div>
            </div>

            <!-- Concurrent downloads -->
            <div data-settings-item class="settings-row scroll-mt-6 lg:scroll-mt-20">
              <div class="settings-row__text">
                <h3 data-i18n="settings.downloadsFolder.concurrency" class="text-sm font-medium leading-snug">Concurrent downloads</h3>
                <p data-i18n="settings.downloadsFolder.concurrencyHelper" class="text-xs text-fg-3">
                  Most Xtream providers cap connections per account, so a second
                  parallel download fails mid-stream. Keep this at 1 unless your
                  provider explicitly allows multiple slots.
                </p>
              </div>
              <div class="settings-row__control flex-col items-end gap-1">
                <div
                  id="settings-download-concurrency"
                  class="settings-seg"
                  role="radiogroup"
                  aria-label="Concurrent downloads"
                  data-i18n-attr="aria-label:settings.downloadsFolder.concurrency">
                  <button type="button" data-concurrency="1" aria-pressed="false" class="dl-concurrency-btn btn">1</button>
                  <button type="button" data-concurrency="2" aria-pressed="false" class="dl-concurrency-btn btn">2</button>
                  <button type="button" data-concurrency="3" aria-pressed="false" class="dl-concurrency-btn btn">3</button>
                  <button type="button" data-concurrency="4" aria-pressed="false" class="dl-concurrency-btn btn">4</button>
                </div>
                <p
                  id="settings-download-concurrency-cap"
                  class="text-2xs text-fg-3 tabular-nums empty:hidden"
                  aria-live="polite"></p>
              </div>
            </div>

            <!-- Kodi .nfo sidecar: desktop only -->
            <div id="card-write-nfo" data-settings-item class="hidden settings-row scroll-mt-6 lg:scroll-mt-20">
              <div class="settings-row__text">
                <h3 data-i18n="settings.downloadsFolder.nfoTitle" class="text-sm font-medium leading-snug">Write Kodi metadata</h3>
                <p data-i18n="settings.downloadsFolder.nfoHelper" class="text-xs text-fg-3">
                  Save a .nfo file with title, year, plot and poster next to each finished download so Kodi, Jellyfin or Emby can index it.
                </p>
              </div>
              <div class="settings-row__control">
                <div
                  id="settings-write-nfo"
                  class="settings-seg"
                  role="radiogroup"
                  aria-label="Write Kodi metadata"
                  data-i18n-attr="aria-label:settings.downloadsFolder.nfoTitle">
                  <button type="button" data-nfo="on"  aria-pressed="false" data-i18n="settings.downloadsFolder.nfo.on"  class="write-nfo-btn btn">On</button>
                  <button type="button" data-nfo="off" aria-pressed="false" data-i18n="settings.downloadsFolder.nfo.off" class="write-nfo-btn btn">Off</button>
                </div>
              </div>
            </div>

          </div>
