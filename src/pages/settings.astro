---
import Layout from "@/layouts/Layout.astro"
import {
  IconRefresh,
  IconTrash,
  IconAlertTriangle,
  IconPlus,
  IconFolderOpen,
  IconCloudDownload,
  IconBrandGithub,
  IconDeviceFloppy,
  IconDownload,
  IconUpload,
  IconHeart,
  IconCoffee,
  IconBrandPaypal,
  IconBug,
  IconMail,
  IconChevronDown,
  IconWorld,
  IconPalette,
  IconLayoutSidebar,
  IconClock,
  IconWifi,
  IconFilter,
  IconStar,
  IconArchive,
  IconDatabase,
  IconBrandDiscord,
  IconInfoCircle,
  IconSparkles,
  IconBolt,
  IconPlayerPlay,
  IconBook,
  IconRocket,
  IconLayoutDashboard,
  IconSearch,
  IconX,
  IconShare,
  IconExternalLink,
  IconRestore,
} from "@tabler/icons-svelte"
import HiddenCategoriesEditor from "@/components/HiddenCategoriesEditor.svelte"
import LocalePicker from "@/components/LocalePicker.svelte"
import FavoritesReorder from "@/components/FavoritesReorder.svelte"
import HubStripsEditor from "@/components/HubStripsEditor.svelte"
import PlayerPicker from "@/components/PlayerPicker.svelte"
import TvOverscanCard from "@/components/TvOverscanCard.svelte"
import CloseToTrayCard from "@/components/CloseToTrayCard.svelte"
import ConnectionLimitBanner from "@/components/ConnectionLimitBanner.svelte"
import AndroidNativePlayerCard from "@/components/AndroidNativePlayerCard.svelte"
import RememberedAndroidPlayerCard from "@/components/RememberedAndroidPlayerCard.svelte"

interface NavCard { id: string; labelKey: string; label: string }
interface NavSection { id: string; labelKey: string; label: string; cards: NavCard[]; danger?: boolean }

const navStructure: NavSection[] = [
  { id: "settings-playlists", labelKey: "settings.group.playlists", label: "Playlists", cards: [] },
  { id: "settings-appearance", labelKey: "settings.group.appearance", label: "Appearance", cards: [
    { id: "card-language",          labelKey: "settings.section.language",     label: "Language" },
    { id: "card-display",           labelKey: "settings.section.display",      label: "Display" },
    { id: "card-perf-mode",         labelKey: "settings.perfMode.title",       label: "Performance mode" },
    { id: "card-tv-overscan",       labelKey: "settings.tvOverscan.title",     label: "TV safe area" },
    { id: "card-hub-strips",        labelKey: "settings.hubStrips.title",      label: "Home page sections" },
    { id: "close-behavior-section", labelKey: "settings.closeBehavior.title",  label: "Close button behavior" },
  ]},
  { id: "settings-watching", labelKey: "settings.group.watching", label: "Watching", cards: [
    { id: "card-livetv-layout",             labelKey: "settings.livetvLayout.title",           label: "Live TV layout" },
    { id: "card-progress-retention",        labelKey: "settings.progressRetention.title",      label: "Continue watching" },
    { id: "epg-tz-section",                 labelKey: "settings.epgTimezone.title",            label: "EPG time zone" },
    { id: "playback-section",               labelKey: "settings.playback.title",               label: "Playback" },
    { id: "android-native-player-section",  labelKey: "settings.androidNativePlayer.navLabel", label: "Native Android player" },
    { id: "android-default-player-section", labelKey: "settings.androidDefaultPlayer.navLabel", label: "Default external player" },
  ]},
  { id: "settings-network", labelKey: "settings.group.network", label: "Network", cards: [
    { id: "card-network",          labelKey: "settings.network.title", label: "Network" },
    { id: "discord-rpc-section",   labelKey: "settings.discord.title", label: "Discord Rich Presence" },
  ]},
  { id: "settings-library", labelKey: "settings.group.library", label: "Library", cards: [
    { id: "card-categories", labelKey: "settings.categories.title",        label: "Categories" },
    { id: "card-favorites",  labelKey: "settings.favoritesSection.title",  label: "Favorites" },
  ]},
  { id: "settings-data", labelKey: "settings.group.data", label: "Data", cards: [
    { id: "downloads-folder-section", labelKey: "settings.downloadsSection.title", label: "Downloads" },
    { id: "card-backup",              labelKey: "settings.backup.title",           label: "Backup" },
    { id: "card-storage",             labelKey: "settings.storage.title",          label: "Storage" },
  ]},
  { id: "settings-help", labelKey: "settings.group.help", label: "Help & feedback", cards: [
    { id: "card-docs",     labelKey: "settings.help.docsTitle", label: "Read the docs" },
    { id: "card-feedback", labelKey: "settings.nav.feedback",   label: "Send feedback" },
  ]},
  { id: "settings-about", labelKey: "settings.group.about", label: "About", cards: [
    { id: "update-section",    labelKey: "settings.nav.appUpdate",  label: "App update" },
    { id: "changelog-section", labelKey: "settings.about.whatsNew", label: "What's new" },
  ]},
  { id: "settings-support", labelKey: "settings.group.support", label: "Support", cards: [] },
  { id: "settings-danger",  labelKey: "settings.group.dangerZone", label: "Danger zone", cards: [], danger: true },
]
---

<Layout pageTitle="Settings">
  <main class="flex-1 min-h-0 overflow-y-auto overflow-x-clip custom-scroll">
    <div
      class="w-full max-w-480 mx-auto px-4 md:px-6 lg:px-8 pt-4 lg:pt-6 pb-12 flex flex-col gap-6 lg:gap-8">

    <header class="route-hero shrink-0">
      <h1 data-i18n="settings.title" class="route-hero__title">Settings</h1>
      <p data-i18n="page.settings.sub" class="route-hero__sub">
        Playlists, preferences, cache, and the app itself.
      </p>
    </header>

    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-10">

    <div class="settings-nav-scroller -mx-4 sm:-mx-6 lg:m-0 lg:contents">
    <nav
      aria-label="Settings sections"
      data-i18n-attr="aria-label:settings.nav.aria"
      class="settings-nav
        flex flex-row gap-1 px-4 sm:px-6 w-max
        lg:flex-col lg:gap-0.5 lg:px-0 lg:py-1 lg:w-52
        lg:sticky lg:top-6 lg:self-start">
      {navStructure.map((section) => (
        <Fragment>
          <a
            href={`#${section.id}`}
            data-i18n={section.labelKey}
            class="settings-nav-link"
            {...(section.danger ? { "data-danger": "true" } : {})}>
            {section.label}
          </a>
          {section.cards.length > 1 && (
            <ul class="settings-subnav hidden lg:flex flex-col list-none m-0 p-0">
              {section.cards.map((card) => (
                <li class="m-0">
                  <a
                    href={`#${card.id}`}
                    data-i18n={card.labelKey}
                    class="settings-subnav-link">
                    {card.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </Fragment>
      ))}
    </nav>
    </div>

    <div class="settings-stack flex-1 min-w-0">

    <div class="lg:sticky lg:top-2 lg:z-10 -mt-2 pt-2 pb-3">
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-fg-3 pointer-events-none inline-flex">
          <IconSearch aria-hidden="true" stroke={2} size={16} />
        </span>
        <input
          id="settings-search-input"
          type="search"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="search"
          data-i18n-attr="placeholder:settings.search.placeholder;aria-label:settings.search.placeholder"
          placeholder="Search settings"
          class="w-full h-11 rounded-xl border border-line bg-surface text-fg
            pl-10 pr-11 text-sm placeholder:text-fg-3
            focus-visible:border-accent outline-none
            transition-colors"
        />
        <button
          id="settings-search-clear"
          type="button"
          data-i18n-attr="aria-label:settings.search.clear"
          aria-label="Clear search"
          class="absolute right-1 top-1/2 -translate-y-1/2 size-9 rounded-md
            text-fg-3 hover:text-fg hover:bg-surface-2
            focus-visible:text-fg focus-visible:bg-surface-2
            inline-flex items-center justify-center transition-colors"
          hidden>
          <IconX aria-hidden="true" stroke={2} size={16} />
        </button>
      </div>
      <p
        id="settings-search-empty"
        data-i18n="settings.search.noMatches"
        class="mt-3 text-sm text-fg-3 px-1"
        role="status"
        aria-live="polite"
        hidden>
        No settings match your search.
      </p>
    </div>

    <!-- Group: Playlists -->
    <section id="settings-playlists" class="settings-group scroll-mt-8">
      <h2 data-i18n="settings.group.playlists" class="settings-group__title">Playlists</h2>
      <div class="rounded-2xl border border-line bg-surface p-5 sm:p-6 flex flex-col gap-4">
        <div
          id="settings-playlists-list"
          class="flex flex-col divide-y divide-line/60 rounded-xl border border-line bg-bg overflow-hidden">
          <div data-i18n="settings.playlists.empty" class="px-4 py-4 text-xs text-fg-3">No playlists yet.</div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
          <a href="/login" class="btn justify-start sm:justify-center">
            <IconPlus aria-hidden="true" class="btn-icon" />
            <span data-i18n="playlist.add">Add playlist</span>
          </a>
          <button
            id="settings-refresh-active"
            type="button"
            class="btn justify-start sm:justify-center hidden">
            <IconRefresh aria-hidden="true" class="btn-icon" />
            <span data-i18n="playlist.refreshActive">Refresh active</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Group: Appearance (language, theme/font, perf mode, home page sections, close behavior) -->
    <section id="settings-appearance" class="settings-group scroll-mt-8">
      <h2 data-i18n="settings.group.appearance" class="settings-group__title">Appearance</h2>
      <div class="flex flex-col gap-4">

        <!-- Language -->
        <article id="card-language" class="icon-mark-host rounded-2xl border border-line bg-surface p-5 sm:p-6 flex flex-col gap-4 scroll-mt-6">
          <div class="flex items-start gap-3">
            <span class="icon-mark">
              <IconWorld aria-hidden="true" stroke={2} />
            </span>
            <div class="flex flex-col gap-1 min-w-0">
              <h3 data-i18n="settings.section.language" class="text-base font-semibold">Language</h3>
              <p data-i18n="settings.language.cardHelper" class="text-xs text-fg-3">
                Pick a language for the interface. Translations are community-driven - missing strings fall back to English.
              </p>
            </div>
          </div>
          <LocalePicker client:load />
        </article>

        <!-- Display: theme + font scale -->
        <article id="card-display" class="icon-mark-host rounded-2xl border border-line bg-surface p-5 sm:p-6 flex flex-col gap-4 scroll-mt-6">
          <div class="flex items-start gap-3">
            <span class="icon-mark">
              <IconPalette aria-hidden="true" stroke={2} />
            </span>
            <div class="flex flex-col gap-1 min-w-0">
              <h3 data-i18n="settings.section.display" class="text-base font-semibold">Display</h3>
              <p data-i18n="settings.display.helper" class="text-xs text-fg-3">
                Theme, accent color and base font size. System theme follows your OS preference.
              </p>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <span data-i18n="settings.theme.label" class="text-eyebrow font-medium uppercase text-fg-3">Theme</span>
            <div
              id="settings-theme"
              class="grid grid-cols-3 gap-2"
              role="radiogroup"
              data-i18n-attr="aria-label:settings.theme.label"
              aria-label="Theme">
              <button type="button" data-theme="system" aria-pressed="false" data-i18n="settings.theme.system" class="theme-btn btn">System</button>
              <button type="button" data-theme="light"  aria-pressed="false" data-i18n="settings.theme.light" class="theme-btn btn">Light</button>
              <button type="button" data-theme="dark"   aria-pressed="false" data-i18n="settings.theme.dark" class="theme-btn btn">Dark</button>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <span data-i18n="settings.accent.label" class="text-eyebrow font-medium uppercase text-fg-3">Accent color</span>
            <div
              id="settings-accent"
              class="flex flex-wrap gap-2"
              role="radiogroup"
              data-i18n-attr="aria-label:settings.accent.label"
              aria-label="Accent color">
              <button type="button" data-accent-value="fuchsia" aria-pressed="false" data-i18n-attr="title:settings.accent.fuchsia;aria-label:settings.accent.fuchsia" title="Fuchsia" aria-label="Fuchsia" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-fuchsia)">
                <span class="size-5 rounded-full bg-(--swatch) group-aria-pressed:ring-2 group-aria-pressed:ring-(--swatch) group-aria-pressed:ring-offset-2 group-aria-pressed:ring-offset-surface" aria-hidden="true"></span>
              </button>
              <button type="button" data-accent-value="rose" aria-pressed="false" data-i18n-attr="title:settings.accent.rose;aria-label:settings.accent.rose" title="Rose" aria-label="Rose" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-rose)">
                <span class="size-5 rounded-full bg-(--swatch) group-aria-pressed:ring-2 group-aria-pressed:ring-(--swatch) group-aria-pressed:ring-offset-2 group-aria-pressed:ring-offset-surface" aria-hidden="true"></span>
              </button>
              <button type="button" data-accent-value="ember" aria-pressed="false" data-i18n-attr="title:settings.accent.ember;aria-label:settings.accent.ember" title="Ember" aria-label="Ember" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-ember)">
                <span class="size-5 rounded-full bg-(--swatch) group-aria-pressed:ring-2 group-aria-pressed:ring-(--swatch) group-aria-pressed:ring-offset-2 group-aria-pressed:ring-offset-surface" aria-hidden="true"></span>
              </button>
              <button type="button" data-accent-value="emerald" aria-pressed="false" data-i18n-attr="title:settings.accent.emerald;aria-label:settings.accent.emerald" title="Emerald" aria-label="Emerald" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-emerald)">
                <span class="size-5 rounded-full bg-(--swatch) group-aria-pressed:ring-2 group-aria-pressed:ring-(--swatch) group-aria-pressed:ring-offset-2 group-aria-pressed:ring-offset-surface" aria-hidden="true"></span>
              </button>
              <button type="button" data-accent-value="cyan" aria-pressed="false" data-i18n-attr="title:settings.accent.cyan;aria-label:settings.accent.cyan" title="Cyan" aria-label="Cyan" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-cyan)">
                <span class="size-5 rounded-full bg-(--swatch) group-aria-pressed:ring-2 group-aria-pressed:ring-(--swatch) group-aria-pressed:ring-offset-2 group-aria-pressed:ring-offset-surface" aria-hidden="true"></span>
              </button>
              <button type="button" data-accent-value="blue" aria-pressed="false" data-i18n-attr="title:settings.accent.blue;aria-label:settings.accent.blue" title="Blue" aria-label="Blue" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-blue)">
                <span class="size-5 rounded-full bg-(--swatch) group-aria-pressed:ring-2 group-aria-pressed:ring-(--swatch) group-aria-pressed:ring-offset-2 group-aria-pressed:ring-offset-surface" aria-hidden="true"></span>
              </button>
              <button type="button" data-accent-value="violet" aria-pressed="false" data-i18n-attr="title:settings.accent.violet;aria-label:settings.accent.violet" title="Violet" aria-label="Violet" class="accent-btn btn group size-11 p-0" style="--swatch: var(--accent-swatch-violet)">
                <span class="size-5 rounded-full bg-(--swatch) group-aria-pressed:ring-2 group-aria-pressed:ring-(--swatch) group-aria-pressed:ring-offset-2 group-aria-pressed:ring-offset-surface" aria-hidden="true"></span>
              </button>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <span data-i18n="settings.fontScale.label" class="text-eyebrow font-medium uppercase text-fg-3">Font scale</span>
            <p data-i18n="settings.fontScale.helper" class="text-xs text-fg-3">
              Bumps the base font size. Use Large or X-Large when viewing on a TV from across the room.
            </p>
            <div
              id="settings-font-scale"
              class="grid grid-cols-2 sm:grid-cols-4 gap-2"
              role="radiogroup"
              data-i18n-attr="aria-label:settings.fontScale.label"
              aria-label="Font scale">
              <button type="button" data-scale="1"     aria-pressed="false" data-i18n="settings.fontScale.default" class="font-scale-btn btn">Default</button>
              <button type="button" data-scale="1.125" aria-pressed="false" data-i18n="settings.fontScale.medium" class="font-scale-btn btn">Medium</button>
              <button type="button" data-scale="1.25"  aria-pressed="false" data-i18n="settings.fontScale.large" class="font-scale-btn btn">Large</button>
              <button type="button" data-scale="1.5"   aria-pressed="false" data-i18n="settings.fontScale.xlarge" class="font-scale-btn btn">X-Large</button>
            </div>
          </div>
          <script is:inline>
            try {
              var savedFontScale = parseFloat(localStorage.getItem("xt_font_scale") || "1");
              if (!isFinite(savedFontScale) || savedFontScale < 0.75 || savedFontScale > 2) savedFontScale = 1;
              var fontScaleGroup = document.getElementById("settings-font-scale");
              if (fontScaleGroup) {
                var fontScaleBtns = fontScaleGroup.querySelectorAll(".font-scale-btn");
                for (var i = 0; i < fontScaleBtns.length; i++) {
                  var btnScale = parseFloat(fontScaleBtns[i].getAttribute("data-scale") || "1");
                  fontScaleBtns[i].setAttribute("aria-pressed", Math.abs(btnScale - savedFontScale) < 0.001 ? "true" : "false");
                }
              }
              var currentTheme = localStorage.getItem("xt_theme") || "dark";
              var themeGroup = document.getElementById("settings-theme");
              if (themeGroup) {
                var themeBtns = themeGroup.querySelectorAll(".theme-btn");
                for (var j = 0; j < themeBtns.length; j++) {
                  themeBtns[j].setAttribute("aria-pressed", themeBtns[j].getAttribute("data-theme") === currentTheme ? "true" : "false");
                }
              }
              var currentAccent = localStorage.getItem("xt_accent") || "fuchsia";
              var accentGroup = document.getElementById("settings-accent");
              if (accentGroup) {
                var accentBtns = accentGroup.querySelectorAll(".accent-btn");
                for (var k = 0; k < accentBtns.length; k++) {
                  accentBtns[k].setAttribute("aria-pressed", accentBtns[k].getAttribute("data-accent-value") === currentAccent ? "true" : "false");
                }
              }
            } catch (e) {}
          </script>
        </article>

        <!-- Performance mode: skip decorative animations + focus-glide for low-end TV WebViews -->
        <article id="card-perf-mode" class="icon-mark-host rounded-2xl border border-line bg-surface p-5 sm:p-6 flex flex-col gap-4 scroll-mt-6">
          <div class="flex items-start gap-3">
            <span class="icon-mark">
              <IconBolt aria-hidden="true" stroke={2} />
            </span>
            <div class="flex flex-col gap-1 min-w-0">
              <h3 data-i18n="settings.perfMode.title" class="text-base font-semibold">Performance mode</h3>
              <p data-i18n="settings.perfMode.helperLong" class="text-xs text-fg-3">
                Disables decorative animations (the comet in the sidebar, hub entry stagger, sliding focus ring) for smoother scrolling and D-pad navigation on TV boxes and low-end devices.
              </p>
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <span data-i18n="settings.perfMode.label" class="text-eyebrow font-medium uppercase text-fg-3">Performance mode</span>
            <div
              id="settings-perf-mode"
              class="grid grid-cols-2 gap-2"
              role="radiogroup"
              aria-label="Performance mode"
              data-i18n-attr="aria-label:settings.perfMode.label">
              <button type="button" data-perf="on"  aria-pressed="false" data-i18n="settings.perfMode.on"  class="perf-mode-btn btn">On</button>
              <button type="button" data-perf="off" aria-pressed="false" data-i18n="settings.perfMode.off" class="perf-mode-btn btn">Off</button>
            </div>
          </div>
          <script is:inline>
            try {
              var perfOn = localStorage.getItem("xt_perf_mode") === "1";
              var perfGroup = document.getElementById("settings-perf-mode");
              if (perfGroup) {
                var perfBtns = perfGroup.querySelectorAll(".perf-mode-btn");
                for (var pIdx = 0; pIdx < perfBtns.length; pIdx++) {
                  var perfBtnOn = perfBtns[pIdx].getAttribute("data-perf") === "on";
                  perfBtns[pIdx].setAttribute("aria-pressed", perfBtnOn === perfOn ? "true" : "false");
                }
              }
            } catch (e) {}
          </script>
        </article>

        <TvOverscanCard client:load />

        <!-- Home page sections: which hub strips render, and in what order. -->
        <article id="card-hub-strips" class="icon-mark-host rounded-2xl border border-line bg-surface p-5 sm:p-6 flex flex-col gap-4 scroll-mt-6">
          <div class="flex items-start gap-3">
            <span class="icon-mark">
              <IconLayoutDashboard aria-hidden="true" stroke={2} />
            </span>
            <div class="flex flex-col gap-1 min-w-0">
              <h3 data-i18n="settings.hubStrips.title" class="text-base font-semibold">Home page sections</h3>
              <p data-i18n="settings.hubStrips.helper" class="text-xs text-fg-3">
                Choose which sections appear on your home page and what order they're in.
              </p>
            </div>
          </div>
          <HubStripsEditor client:load />
        </article>

        <CloseToTrayCard client:load />

      </div>
    </section>

    <!-- Group: Watching (Live TV layout, continue watching retention, EPG time zone, playback) -->
    <section id="settings-watching" class="settings-group scroll-mt-8">
      <h2 data-i18n="settings.group.watching" class="settings-group__title">Watching</h2>
      <div class="flex flex-col gap-4">

        <!-- Live TV layout: EPG default + channel column width -->
        <article id="card-livetv-layout" class="icon-mark-host rounded-2xl border border-line bg-surface p-5 sm:p-6 flex flex-col gap-4 scroll-mt-6">
          <div class="flex items-start gap-3">
            <span class="icon-mark">
              <IconLayoutSidebar aria-hidden="true" stroke={2} />
            </span>
            <div class="flex flex-col gap-1 min-w-0">
              <h3 data-i18n="settings.livetvLayout.title" class="text-base font-semibold">Live TV layout</h3>
              <p data-i18n="settings.livetvLayout.helperLong" class="text-xs text-fg-3">
                Defaults for the channel sidebar and the EPG panel on Live TV. The EPG button on the page itself still toggles per session.
              </p>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <span data-i18n="settings.livetvLayout.epgDefault" class="text-eyebrow font-medium uppercase text-fg-3">Show EPG by default</span>
            <div
              id="settings-epg-default"
              class="grid grid-cols-2 gap-2"
              role="radiogroup"
              aria-label="Show EPG by default" data-i18n-attr="aria-label:aria.showEpgDefault">
              <button type="button" data-epg="on"  aria-pressed="false" data-i18n="settings.livetvLayout.epg.on" class="epg-default-btn btn">On</button>
              <button type="button" data-epg="off" aria-pressed="false" data-i18n="settings.livetvLayout.epg.off" class="epg-default-btn btn">Off</button>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <span data-i18n="settings.livetvLayout.columnWidth" class="text-eyebrow font-medium uppercase text-fg-3">Channel column width</span>
            <div
              id="settings-channel-width"
              class="grid grid-cols-2 sm:grid-cols-4 gap-2"
