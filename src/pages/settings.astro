    const GITHUB_RELEASES_URL =
      "https://github.com/infinitel8p/Extreme-InfiniTV/releases"

    function setUpdateState(state) {
      if (updateSectionEl) updateSectionEl.setAttribute("data-state", state)
      if (updatePillEl) {
        if (state === "available") {
          updatePillEl.classList.remove("hidden")
          updatePillEl.classList.add("inline-flex")
        } else {
          updatePillEl.classList.add("hidden")
          updatePillEl.classList.remove("inline-flex")
        }
      }
    }

    const isWindowsDesktop =
      isTauri && /Windows/i.test(navigator.userAgent || "")
    const isLinuxDesktop =
      isTauri &&
      /Linux/i.test(navigator.userAgent || "") &&
      !/Android/i.test(navigator.userAgent || "")
    const storeBuild = await isStoreBuild()
    const playStoreInstall = isPlayStoreInstall()
    // Snap/Flatpak: store owns updates, same as MS Store.
    const sandboxed = isLinuxDesktop ? sandboxRuntimeSync() : null
    const noInAppUpdate = storeBuild || !!sandboxed
    // Linux falls back to the GitHub check below if `check()` throws (non-AppImage installs).
    const canUseTauriUpdater = (isWindowsDesktop && !storeBuild) || (isLinuxDesktop && !sandboxed)

    if (updateChannelSelectEl) updateChannelSelectEl.value = getUpdateChannel()
    if (noInAppUpdate) updateChannelRowEl?.setAttribute("hidden", "")

    if (autoUpdateSelectEl) autoUpdateSelectEl.value = getAutoUpdateEnabled() ? "on" : "off"
    if (!canUseTauriUpdater) autoUpdateRowEl?.setAttribute("hidden", "")

    if (updateCurrentEl) {
      try {
        const { getVersion } = await import("@tauri-apps/api/app")
        updateCurrentEl.textContent = await getVersion()
      } catch {
        const tag = document.querySelector(
          'meta[name="x-app-version"]'
        )?.getAttribute("content")
        updateCurrentEl.textContent = tag || "-"
      }
    }

    if (!canUseTauriUpdater) {
      updateManualOnlyEl?.removeAttribute("hidden")
      // data-i18n stays in sync with locale changes; textContent updates it immediately.
      if (updateGetLabelEl && storeBuild) {
        updateGetLabelEl.setAttribute("data-i18n", "settings.update.getFromStore")
        updateGetLabelEl.textContent = t("settings.update.getFromStore")
      } else if (updateGetLabelEl && playStoreInstall) {
        updateGetLabelEl.setAttribute("data-i18n", "settings.update.getFromPlay")
        updateGetLabelEl.textContent = t("settings.update.getFromPlay")
      }
    }

    let pendingUpdate = null
    // "plugin": pendingUpdate is a @tauri-apps/plugin-updater Update object.
    // "invoke": pendingUpdate is the {version, notes, pubDate} payload from updater_check_from (beta channel).
    let updateInstallMode = "plugin"

    let progressFrame = 0
    let queuedProgress = null

    function setProgress(pct, text) {
      if (progressFrame) {
        cancelAnimationFrame(progressFrame)
        progressFrame = 0
        queuedProgress = null
      }
      paintProgress(pct, text)
    }

    // Progress events can arrive far faster than frames; paint at most once per frame.
    function queueProgress(pct, text) {
      queuedProgress = { pct, text }
      if (progressFrame) return
      progressFrame = requestAnimationFrame(() => {
        progressFrame = 0
        if (!queuedProgress) return
        paintProgress(queuedProgress.pct, queuedProgress.text)
        queuedProgress = null
      })
    }

    function paintProgress(pct, text) {
      if (!updateProgressWrap || !updateProgressBar || !updateProgressText) return
      if (pct == null) {
        updateProgressWrap.classList.add("hidden")
        updateProgressWrap.classList.remove("flex")
        return
      }
      updateProgressWrap.classList.remove("hidden")
      updateProgressWrap.classList.add("flex")
      if (pct < 0) {
        updateProgressBar.classList.add("indeterminate")
        updateProgressBar.style.width = "40%"
        updateProgressText.textContent = text || ""
        // Absent aria-valuenow is how ARIA signals an indeterminate progressbar.
        updateProgressTrack?.removeAttribute("aria-valuenow")
        return
      }
      updateProgressBar.classList.remove("indeterminate")
      const clamped = Math.max(0, Math.min(100, pct))
      updateProgressBar.style.width = `${clamped}%`
      updateProgressText.textContent = text || `${clamped.toFixed(0)}%`
      updateProgressTrack?.setAttribute("aria-valuenow", String(Math.round(clamped)))
    }

    function fmtUpdateBytes(n) {
      if (!n) return "0 B"
      if (n < 1024) return `${n} B`
      if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`
      return `${(n / (1024 * 1024)).toFixed(1)} MB`
    }

    function setInstallLabel(text) {
      if (updateInstallLabelEl) updateInstallLabelEl.textContent = text
    }

    let updateGetTarget = GITHUB_RELEASES_URL

    async function checkViaBetaInvoke() {
      const { invoke } = await import("@tauri-apps/api/core")
      const url = await resolveUpdateFeedUrl()
      const update = await invoke("updater_check_from", { url })
      updateInstallMode = "invoke"
      if (!update) {
        pendingUpdate = null
        if (updateLatestEl) updateLatestEl.textContent = t("settings.about.upToDate")
        if (updateMsgEl) updateMsgEl.textContent = t("settings.update.upToDateMsg")
        if (updateGithubLink) {
          updateGithubLink.href = `${GITHUB_RELEASES_URL}/latest`
        }
        setUpdateState("up-to-date")
        return
      }
      pendingUpdate = update
      if (updateLatestEl) {
        updateLatestEl.textContent = update.version
          ? `v${update.version}`
          : t("settings.update.available")
      }
      if (updateNotesEl && update.notes) {
        updateNotesEl.textContent = update.notes
        updateNotesEl.classList.remove("hidden")
      }
      if (updateMsgEl) {
        updateMsgEl.textContent = update.pubDate
          ? t("settings.update.releasedOn", { date: new Date(update.pubDate).toLocaleDateString() })
          : t("settings.update.updateAvailableMsg")
      }
      if (updateGithubLink) {
        updateGithubLink.href = update.version
          ? `${GITHUB_RELEASES_URL}/tag/v${update.version}`
          : `${GITHUB_RELEASES_URL}/latest`
      }
      updateInstallBtn?.removeAttribute("hidden")
      setUpdateState("available")
    }

    async function checkViaTauriUpdater() {
      if (getUpdateChannel() === "beta") {
        await checkViaBetaInvoke()
        return
      }
      updateInstallMode = "plugin"
      const { check } = await import("@tauri-apps/plugin-updater")
      const update = await check()
      if (!update) {
        pendingUpdate = null
        if (updateLatestEl) updateLatestEl.textContent = t("settings.about.upToDate")
        if (updateMsgEl) updateMsgEl.textContent = t("settings.update.upToDateMsg")
        if (updateGithubLink) {
          updateGithubLink.href = `${GITHUB_RELEASES_URL}/latest`
        }
        setUpdateState("up-to-date")
        return
      }
      pendingUpdate = update
      if (updateLatestEl) {
        updateLatestEl.textContent = update.version
          ? `v${update.version}`
          : t("settings.update.available")
      }
      if (updateNotesEl && update.body) {
        updateNotesEl.textContent = update.body
        updateNotesEl.classList.remove("hidden")
      }
      if (updateMsgEl) {
        updateMsgEl.textContent = update.date
          ? t("settings.update.releasedOn", { date: new Date(update.date).toLocaleDateString() })
          : t("settings.update.updateAvailableMsg")
      }
      if (updateGithubLink) {
        updateGithubLink.href = update.version
          ? `${GITHUB_RELEASES_URL}/tag/v${update.version}`
          : `${GITHUB_RELEASES_URL}/latest`
      }
      updateInstallBtn?.removeAttribute("hidden")
      setUpdateState("available")
    }

    async function checkViaGithub() {
      const status = await checkForUpdate()
      if (!status) throw new Error("couldn't reach GitHub")
      if (updateGithubLink) updateGithubLink.href = status.latestUrl
      if (!status.updateAvailable) {
        if (updateLatestEl) updateLatestEl.textContent = t("settings.about.upToDate")
        if (updateMsgEl) updateMsgEl.textContent = t("settings.update.upToDateMsg")
        updateGetBtn?.setAttribute("hidden", "")
        updateDegradedEl?.setAttribute("hidden", "")
        setUpdateState("up-to-date")
        return
      }
      updateGetTarget = storeBuild
        ? MS_STORE_UPDATES_URL
        : playStoreInstall
          ? getPlayStoreUrl()
          : status.latestUrl
      if (updateLatestEl) updateLatestEl.textContent = `v${status.latest}`
      if (updateMsgEl) {
        updateMsgEl.textContent = status.publishedAt
          ? t("settings.update.releasedOn", { date: new Date(status.publishedAt).toLocaleDateString() })
          : t("settings.update.updateAvailableMsg")
      }
      if (updateNotesEl && status.notes) {
        updateNotesEl.textContent = status.notes
        updateNotesEl.classList.remove("hidden")
      }
      // No package-manager deep link to send Snap/Flatpak users to.
      if (sandboxed) updateGetBtn?.setAttribute("hidden", "")
      else updateGetBtn?.removeAttribute("hidden")
      setUpdateState("available")
    }

    async function checkForUpdates() {
      if (updateMsgEl) updateMsgEl.textContent = t("settings.update.checking")
      setUpdateState("checking")
      updateCheckBtn?.setAttribute("disabled", "")
      updateInstallBtn?.setAttribute("hidden", "")
      updateRelaunchBtn?.setAttribute("hidden", "")
      updateGetBtn?.setAttribute("hidden", "")
      updateDegradedEl?.setAttribute("hidden", "")
      setInstallLabel(t("settings.about.installUpdate"))
      setProgress(null)
      if (updateNotesEl) {
        updateNotesEl.textContent = ""
        updateNotesEl.classList.add("hidden")
      }

      if (canUseTauriUpdater) {
        try {
          await withUpdaterRetry(checkViaTauriUpdater)
          updateCheckBtn?.removeAttribute("disabled")
          return
        } catch (e) {
          log.warn("Tauri update check failed, falling back to GitHub check:", e)
          if (isTransientUpdaterError(e)) updateDegradedEl?.removeAttribute("hidden")
        }
      }

      try {
        await checkViaGithub()
      } catch (e) {
        log.error("Update check failed:", e)
        if (updateMsgEl) {
          updateMsgEl.textContent = t("settings.update.checkFailed", { error: String(e?.message || e) })
        }
        setUpdateState("error")
      } finally {
        updateCheckBtn?.removeAttribute("disabled")
      }
    }

    async function installUpdateViaInvoke() {
      updateInstallBtn?.setAttribute("disabled", "")
      updateCheckBtn?.setAttribute("disabled", "")
      let total = 0
      let received = 0
      let unlisten = null
      setProgress(0, t("settings.update.preparing"))
      try {
        const { listen } = await import("@tauri-apps/api/event")
        const { invoke } = await import("@tauri-apps/api/core")
        unlisten = await listen("xt:updater-progress", (event) => {
          const payload = event.payload
          if (payload.event === "Started") {
            total = payload.data?.contentLength || 0
            setProgress(total ? 0 : -1, total ? `0 / ${fmtUpdateBytes(total)}` : t("settings.update.starting"))
          } else if (payload.event === "Progress") {
            received += payload.data?.chunkLength || 0
            const pct = total ? (received / total) * 100 : -1
            queueProgress(
              pct,
              total
                ? `${fmtUpdateBytes(received)} / ${fmtUpdateBytes(total)}`
                : fmtUpdateBytes(received)
            )
          } else if (payload.event === "Finished") {
            setProgress(100, t("settings.update.installed"))
            if (updateMsgEl) updateMsgEl.textContent = t("settings.update.installedRestart")
            setInstallLabel(t("settings.about.installUpdate"))
            updateRelaunchBtn?.removeAttribute("hidden")
          }
        })
        await invoke("updater_install")
        // Windows exits the process here; the "Finished" event above is the terminal UI state.
      } catch (e) {
        log.error("Update install failed:", e)
        if (updateMsgEl) {
          const message = String(e?.message || e || "").replace(/^OTHER:/, "")
          updateMsgEl.textContent = t("settings.update.downloadFailed", { error: message })
        }
        setProgress(null)
        setInstallLabel(t("settings.update.reDownload"))
        updateInstallBtn?.removeAttribute("disabled")
      } finally {
        if (unlisten) unlisten()
        updateCheckBtn?.removeAttribute("disabled")
      }
    }

    async function installUpdate() {
      if (!pendingUpdate) return
      if (updateInstallMode === "invoke") {
        await installUpdateViaInvoke()
        return
      }
      updateInstallBtn?.setAttribute("disabled", "")
      updateCheckBtn?.setAttribute("disabled", "")
      let total = 0
      let received = 0
      setProgress(0, t("settings.update.preparing"))
      try {
        await pendingUpdate.downloadAndInstall((event) => {
          if (event.event === "Started") {
            total = event.data?.contentLength || 0
            setProgress(total ? 0 : -1, total ? `0 / ${fmtUpdateBytes(total)}` : t("settings.update.starting"))
          } else if (event.event === "Progress") {
            received += event.data?.chunkLength || 0
            const pct = total ? (received / total) * 100 : -1
            queueProgress(
              pct,
              total
                ? `${fmtUpdateBytes(received)} / ${fmtUpdateBytes(total)}`
                : fmtUpdateBytes(received)
            )
          } else if (event.event === "Finished") {
            setProgress(100, t("settings.update.installed"))
          }
        })
        if (updateMsgEl) {
          updateMsgEl.textContent = t("settings.update.installedRestart")
        }
        setInstallLabel(t("settings.about.installUpdate"))
        updateRelaunchBtn?.removeAttribute("hidden")
      } catch (e) {
        log.error("Update install failed:", e)
        if (updateMsgEl) {
          updateMsgEl.textContent = t("settings.update.downloadFailed", { error: String(e?.message || e) })
        }
        setProgress(null)
        setInstallLabel(t("settings.update.reDownload"))
        updateInstallBtn?.removeAttribute("disabled")
      } finally {
        updateCheckBtn?.removeAttribute("disabled")
      }
    }

    async function relaunchApp() {
      try {
        const { relaunch } = await import("@tauri-apps/plugin-process")
        await relaunch()
      } catch (e) {
        log.error("Relaunch failed:", e)
        if (updateMsgEl) {
          updateMsgEl.textContent = `Restart failed - ${String(e?.message || e)}`
        }
      }
    }

    updateCheckBtn?.addEventListener("click", checkForUpdates)
    updateInstallBtn?.addEventListener("click", installUpdate)
    updateRelaunchBtn?.addEventListener("click", relaunchApp)
    updateGetBtn?.addEventListener("click", () => {
      openExternal(updateGetTarget)
    })
    updateChannelSelectEl?.addEventListener("change", () => {
      setUpdateChannel(updateChannelSelectEl.value)
      checkForUpdates()
    })

    autoUpdateSelectEl?.addEventListener("change", () => {
      setAutoUpdateEnabled(autoUpdateSelectEl.value === "on")
    })

    checkForUpdates()

    // -------------------------------------------------------------------
    // Discord Rich Presence
    // -------------------------------------------------------------------
    const discordSection = document.getElementById("discord-rpc-section")
    const discordClientIdInput = /** @type {HTMLInputElement|null} */ (
      document.getElementById("discord-client-id")
    )
    const discordPlaylistsEl = document.getElementById("discord-playlists")

    if (discordSection && discordRpcSupported) {
      discordSection.classList.remove("hidden")
      // Flatpak grants the IPC socket (xdg-run/discord-ipc-0); snap doesn't.
      if (sandboxed === "snap") {
        document.getElementById("discord-controls")?.setAttribute("hidden", "")
        document.getElementById("discord-sandbox-note")?.removeAttribute("hidden")
      }
    }

    if (discordClientIdInput) {
      discordClientIdInput.value = getDiscordClientId()
      let saveTimer = null
      discordClientIdInput.addEventListener("input", () => {
        if (saveTimer) window.clearTimeout(saveTimer)
        saveTimer = window.setTimeout(() => {
          setDiscordClientId(discordClientIdInput.value)
        }, 350)
      })
      discordClientIdInput.addEventListener("blur", () => {
        if (saveTimer) {
          window.clearTimeout(saveTimer)
          saveTimer = null
        }
        setDiscordClientId(discordClientIdInput.value)
      })
    }

    async function renderDiscordPlaylists() {
      if (!discordPlaylistsEl) return
      const entries = await getEntries()
      if (!entries.length) {
        discordPlaylistsEl.innerHTML =
          '<div class="px-4 py-4 text-xs text-fg-3">No playlists yet.</div>'
        return
      }
      const frag = document.createDocumentFragment()
      for (const entry of entries) {
        const row = document.createElement("label")
        row.className =
          "flex items-center justify-between gap-3 px-4 py-3 hover:bg-surface-2 transition-colors cursor-pointer"
        const labelWrap = document.createElement("div")
        labelWrap.className = "flex flex-col gap-0.5 min-w-0"
        const title = document.createElement("span")
        title.className = "truncate text-sm font-medium text-fg"
        title.textContent = entry.title || "(untitled)"
        const sub = document.createElement("span")
        sub.className = "truncate text-2xs text-fg-3"
        sub.textContent =
          entry.type === "xtream"
            ? "Xtream"
            : entry.type === "local-m3u"
            ? "Local file"
            : "M3U source"
        labelWrap.append(title, sub)
        row.appendChild(labelWrap)

        const toggle = document.createElement("input")
        toggle.type = "checkbox"
        toggle.className = "size-5 accent-accent"
        toggle.checked = isDiscordEnabledForPlaylist(entry._id)
        toggle.setAttribute(
          "aria-label",
          `Show Discord presence for ${entry.title || "this playlist"}`
        )
        toggle.addEventListener("change", () => {
          setDiscordEnabledForPlaylist(entry._id, toggle.checked)
        })
        row.appendChild(toggle)
        frag.appendChild(row)
      }
      discordPlaylistsEl.replaceChildren(frag)
    }

    renderDiscordPlaylists()
    document.addEventListener("xt:entries-updated", renderDiscordPlaylists)
    document.addEventListener(DISCORD_RPC_EVENT, () => {
      // Keep the input in sync if the value changed elsewhere.
      if (discordClientIdInput) {
        const next = getDiscordClientId()
        if (discordClientIdInput.value !== next) discordClientIdInput.value = next
      }
    })

    // -------------------------------------------------------------------
    // TMDb metadata enrichment
    // -------------------------------------------------------------------
    const tmdbEnabledGroup = document.getElementById("settings-tmdb-enabled")
    const tmdbKeyInput = /** @type {HTMLInputElement|null} */ (
      document.getElementById("settings-tmdb-key")
    )
    const tmdbRevealBtn = /** @type {HTMLButtonElement|null} */ (
      document.getElementById("settings-tmdb-reveal")
    )
    const tmdbTestBtn = /** @type {HTMLButtonElement|null} */ (
      document.getElementById("settings-tmdb-test")
    )
    const tmdbMsgEl = document.getElementById("settings-tmdb-msg")

    function syncTmdbEnabled() {
      if (!tmdbEnabledGroup) return
      const enabled = getTmdbEnabled()
      for (const btn of tmdbEnabledGroup.querySelectorAll(".tmdb-enabled-btn")) {
        const isOn = btn.getAttribute("data-tmdb") === "on"
        btn.setAttribute("aria-pressed", isOn === enabled ? "true" : "false")
      }
    }
    syncTmdbEnabled()

    tmdbEnabledGroup?.addEventListener("click", (event) => {
      const btn = /** @type {HTMLElement} */ (event.target).closest(".tmdb-enabled-btn")
      if (!btn) return
      setTmdbEnabled(btn.getAttribute("data-tmdb") === "on")
      syncTmdbEnabled()
    })

    function syncTmdbTestDisabled() {
      if (tmdbTestBtn) tmdbTestBtn.disabled = !(tmdbKeyInput?.value || "").trim()
    }

    if (tmdbKeyInput) {
      tmdbKeyInput.value = getTmdbApiKey()
      let tmdbSaveTimer = null
      tmdbKeyInput.addEventListener("input", () => {
        syncTmdbTestDisabled()
        if (tmdbSaveTimer) window.clearTimeout(tmdbSaveTimer)
        tmdbSaveTimer = window.setTimeout(() => {
          setTmdbApiKey(tmdbKeyInput.value)
        }, 350)
      })
      tmdbKeyInput.addEventListener("blur", () => {
        if (tmdbSaveTimer) {
          window.clearTimeout(tmdbSaveTimer)
          tmdbSaveTimer = null
        }
        if (tmdbKeyInput.value !== getTmdbApiKey()) setTmdbApiKey(tmdbKeyInput.value)
      })
      syncTmdbTestDisabled()
    }

    tmdbRevealBtn?.addEventListener("click", () => {
      if (!tmdbKeyInput) return
      const revealed = tmdbKeyInput.type === "text"
      tmdbKeyInput.type = revealed ? "password" : "text"
      tmdbRevealBtn.setAttribute("aria-label", t(revealed ? "settings.tmdb.reveal" : "settings.tmdb.conceal"))
      tmdbRevealBtn.querySelector('[data-tmdb-reveal-icon="show"]')?.classList.toggle("hidden", !revealed)
      tmdbRevealBtn.querySelector('[data-tmdb-reveal-icon="hide"]')?.classList.toggle("hidden", revealed)
    })

    tmdbTestBtn?.addEventListener("click", async () => {
      const key = (tmdbKeyInput?.value || getTmdbApiKey() || "").trim()
      setLoading(tmdbTestBtn, true)
      try {
        const result = await validateTmdbKey(key)
        if (result.ok) {
          flashMsg(tmdbMsgEl, t("settings.tmdb.testOk"))
          flashSuccess(tmdbTestBtn)
        } else if (result.status === 401 || result.status === 403 || result.status === 404) {
          flashMsg(tmdbMsgEl, t("settings.tmdb.testFail"))
        } else {
          flashMsg(tmdbMsgEl, t("settings.tmdb.testNetwork"))
        }
      } finally {
        setLoading(tmdbTestBtn, false)
      }
    })

    // -------------------------------------------------------------------
    // Network log: recent provider requests, dev-mode gated.
    // -------------------------------------------------------------------
    const netLogCard = /** @type {HTMLDetailsElement|null} */ (
      document.getElementById("card-net-log")
    )
    const netLogRowsEl = document.getElementById("net-log-rows")
    const netLogCountEl = document.getElementById("net-log-count")
    const netLogMsgEl = document.getElementById("net-log-msg")
    const netLogKindFilterEl = /** @type {HTMLSelectElement|null} */ (
      document.getElementById("net-log-kind-filter")
    )
    const netLogIncludeImagesEl = /** @type {HTMLInputElement|null} */ (
      document.getElementById("net-log-include-images")
    )
    const netLogClearBtn = document.getElementById("net-log-clear")
    const netLogCopyBtn = /** @type {HTMLButtonElement|null} */ (document.getElementById("net-log-copy"))

    const NET_LOG_RENDER_CAP = 100
    const NET_LOG_BADGE = "shrink-0 px-2 py-0.5 rounded-full text-2xs font-medium bg-surface-2 text-fg-3 uppercase tracking-wide"

    function netLogTone(entry) {
      if (entry.outcome === "error") return "bad"
      if (entry.status != null && entry.status >= 500) return "bad"
      if (entry.outcome === "aborted") return "warn"
      if (entry.status != null && entry.status >= 400) return "warn"
      if (entry.outcome === "ok" && entry.status != null && entry.status >= 200 && entry.status < 300) return "good"
      return "neutral"
    }

    function netLogRow(entry) {
      const row = document.createElement("div")
      row.className = "flex flex-col gap-1 px-3 py-2 text-2xs"

      const tone = netLogTone(entry)
      const toneClass =
        tone === "good" ? "text-good" : tone === "warn" ? "text-warn" : tone === "bad" ? "text-bad" : "text-fg-2"

      const metaRow = document.createElement("div")
      metaRow.className = "flex flex-wrap items-center gap-2"

      const time = document.createElement("span")
      time.className = "tabular-nums text-fg-3 shrink-0"
      time.textContent = fmtAgo(entry.startedAt)

      const method = document.createElement("span")
      method.className = "font-mono text-fg-3 shrink-0"
      method.textContent = entry.method

      // No HTTP status: show the outcome word, not just a colour, so failure isn't hue-only.
      const status = document.createElement("span")
      status.className = `tabular-nums font-medium shrink-0 ${toneClass}`
      status.textContent = entry.status != null ? String(entry.status) : entry.outcome.toUpperCase()

      const duration = document.createElement("span")
      duration.className = "tabular-nums text-fg-3 shrink-0"
      duration.textContent = `${entry.durationMs}ms`

      const kindBadge = document.createElement("span")
      kindBadge.className = NET_LOG_BADGE
      kindBadge.textContent = entry.kind

      const transportBadge = document.createElement("span")
      transportBadge.className = NET_LOG_BADGE
      transportBadge.textContent = entry.transport

      metaRow.append(time, method, status, duration, kindBadge, transportBadge)
      row.appendChild(metaRow)

      const url = document.createElement("div")
      url.className = "font-mono text-fg-2 break-all"
      url.textContent = entry.url
      row.appendChild(url)

      if (entry.error) {
        const errorLine = document.createElement("div")
        errorLine.className = "text-bad break-all"
        errorLine.textContent = entry.error
        row.appendChild(errorLine)
      }

      return row
    }

    function netLogCardVisible() {
      return !!netLogCard && !netLogCard.classList.contains("hidden") && netLogCard.open
    }

    function repaintNetLog() {
      if (!netLogRowsEl || !netLogCardVisible()) return

      const snapshot = getNetworkLog()
      const kindFilter = netLogKindFilterEl?.value || "all"
      const filtered = kindFilter === "all"
        ? snapshot.entries
        : snapshot.entries.filter((entry) => entry.kind === kindFilter)
      const newestFirst = filtered.slice().reverse().slice(0, NET_LOG_RENDER_CAP)

      netLogRowsEl.replaceChildren()
      if (!newestFirst.length) {
        const empty = document.createElement("div")
        empty.className = "px-4 py-4 text-xs text-fg-3"
        empty.textContent = t("settings.netLog.empty")
        netLogRowsEl.appendChild(empty)
      } else {
        for (const entry of newestFirst) netLogRowsEl.appendChild(netLogRow(entry))
      }

      if (netLogCountEl) {
        const base = t("settings.netLog.count", { count: snapshot.entries.length, capacity: snapshot.capacity })
        netLogCountEl.textContent = snapshot.dropped > 0
          ? `${base} ${t("settings.netLog.droppedCount", { count: snapshot.dropped })}`
          : base
      }
    }

    // NET_LOG_EVENT can fire dozens of times a second during a catalog load;
    // coalesce repaints into one per frame so it doesn't wipe text selection.
    let netLogRepaintFrame = 0
    function scheduleNetLogRepaint() {
      if (netLogRepaintFrame) return
      netLogRepaintFrame = requestAnimationFrame(() => {
        netLogRepaintFrame = 0
        repaintNetLog()
      })
    }

    if (netLogIncludeImagesEl) netLogIncludeImagesEl.checked = getNetLogIncludeImages()

    netLogCard?.addEventListener("toggle", repaintNetLog)
    netLogKindFilterEl?.addEventListener("change", repaintNetLog)
    netLogIncludeImagesEl?.addEventListener("change", () => {
      setNetLogIncludeImages(netLogIncludeImagesEl.checked)
      repaintNetLog()
    })
    netLogClearBtn?.addEventListener("click", () => {
      clearNetworkLog()
      repaintNetLog()
      flashMsg(netLogMsgEl, t("settings.netLog.cleared"))
    })
    netLogCopyBtn?.addEventListener("click", async () => {
      try {
        await writeClipboardText(JSON.stringify(getNetworkLog(), null, 2))
        toastSuccess(t("settings.netLog.copied"))
        flashSuccess(netLogCopyBtn)
      } catch (copyError) {
        log.warn("[settings] network log copy failed:", copyError)
        toast({ title: t("toast.copyError"), variant: "warn", duration: 2800 })
      }
    })
    document.addEventListener(NET_LOG_EVENT, scheduleNetLogRepaint)
    document.addEventListener(LOCALE_EVENT, repaintNetLog)
    repaintNetLog()
  </script>

  <style>
    /* Mobile chip rail wraps the nav in a scroll container so the nav
       itself can be content-width (w-max) while the wrapper is parent
       width with overflow-x:auto. On lg+ the wrapper becomes
       display:contents and the nav takes over as the sticky vertical
       rail directly inside the flex-row parent. */
    .settings-nav-scroller {
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -ms-overflow-style: none;
      max-width: 100vw;
    }
    .settings-nav-scroller::-webkit-scrollbar { display: none; }

    /* Item styling: ghost text-only link with bg-tint hover/active. No
       border outlines - both the chip pill border and the rail's left bar
       are gone, since those were the visuals that read as "two navs".
       No `outline: none` - the global `:focus-visible` rule in Layout
       paints a 2px accent outline for keyboard focus. */
    .settings-nav-link {
      display: inline-flex;
      align-items: center;
      white-space: nowrap;
      flex-shrink: 0;
      color: var(--color-fg-3);
      font-size: 0.8125rem;
      font-weight: 500;
      text-decoration: none;
      padding: 0.5rem 0.875rem;
      border-radius: 0.5rem;
      min-height: 2.75rem;
      transition:
        color 150ms cubic-bezier(0.16, 1, 0.3, 1),
        background-color 150ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @media (min-width: 64em) {
      .settings-nav-link {
        padding: 0.45rem 0.75rem;
        min-height: 0;
      }
    }
    .settings-nav-link:hover,
    .settings-nav-link:focus-visible {
      color: var(--color-fg);
      background: var(--color-surface-2);
    }
    .settings-nav-link[aria-current="true"] {
      color: var(--color-accent);
      background: var(--color-accent-soft);
    }

    /* Danger-zone entry uses the bad token so it reads as destructive. */
    .settings-nav-link[data-danger="true"] {
      color: color-mix(in oklab, var(--color-bad) 65%, var(--color-fg-3));
    }
    .settings-nav-link[data-danger="true"]:hover,
    .settings-nav-link[data-danger="true"]:focus-visible {
      color: var(--color-bad);
    }
    .settings-nav-link[data-danger="true"][aria-current="true"] {
      color: var(--color-bad);
      background: color-mix(in oklch, var(--color-bad) 10%, transparent);
    }

    .settings-stack[data-search-active] section[data-search="miss"],
    .settings-stack[data-search-active] article[data-search="miss"],
    .settings-stack[data-search-active] [data-settings-item][data-search="miss"] {
      display: none;
    }
    .settings-stack[data-search-active]
      .settings-surface:not([data-settings-item]):not(
        :has([data-settings-item]:not([data-search="miss"]))
      ) {
      display: none;
    }
    .settings-nav-link[data-search-miss],
    .settings-subnav-link[data-search-miss] {
      display: none;
    }

    /* Card-level subnav (lg+ rail only). Each section's cards are listed
       directly after its nav link in the DOM (no wrapper, so the mobile
       horizontal chip rail keeps scrolling cleanly). Visible only when
       the preceding section link is active. */
    @media (min-width: 64em) {
      .settings-subnav {
        display: none;
        margin: 0.1rem 0 0.6rem 0.6rem;
        padding-left: 0.7rem;
        border-left: 1px solid var(--color-line-soft);
        gap: 0.05rem;
      }
      .settings-nav-link[aria-current="true"] + .settings-subnav {
        display: flex;
        flex-direction: column;
      }
      .settings-subnav-link {
        position: relative;
        display: block;
        color: var(--color-fg-3);
        font-size: 0.78rem;
        line-height: 1.4;
        font-weight: 400;
        text-decoration: none;
        padding: 0.3rem 0 0.3rem 0.5rem;
        border-radius: 0.25rem;
        transition: color 120ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .settings-subnav-link:hover,
      .settings-subnav-link:focus-visible {
        color: var(--color-fg);
      }
      .settings-subnav-link[aria-current="true"] {
        color: var(--color-accent);
        font-weight: 500;
      }
      .settings-subnav-link[aria-current="true"]::before {
        content: "";
        position: absolute;
        left: calc(-0.7rem - 1px);
        top: 0.45rem;
        bottom: 0.45rem;
        width: 2px;
        background: var(--color-accent);
        border-radius: 1px;
      }
    }
  </style>

  <script>
    {
      // Mobile chip rail: convert vertical mouse-wheel input into
      // horizontal scrolling so a desktop user with a narrow window can
      // reach off-screen chips without shift+wheel. Skipped on lg+ where
      // the wrapper is display:contents and the rail is vertical.
      const scroller = document.querySelector<HTMLElement>(".settings-nav-scroller")
      if (scroller) {
        scroller.addEventListener("wheel", (event) => {
          if (window.matchMedia("(min-width: 64em)").matches) return
          if (event.deltaY === 0 || event.shiftKey) return
          // Only intercept when there's actually horizontal overflow to
          // scroll, otherwise let the page scroll vertically.
          if (scroller.scrollWidth <= scroller.clientWidth) return
          event.preventDefault()
          scroller.scrollLeft += event.deltaY
        }, { passive: false })
      }

      const sections = Array.from(
        document.querySelectorAll("section.settings-group[id]")
      ) as HTMLElement[]
      const links = Array.from(
        document.querySelectorAll(".settings-nav-link")
      )
      const subnavLinks = Array.from(
        document.querySelectorAll(".settings-subnav-link")
      ) as HTMLAnchorElement[]
      const linksById = new Map<string, HTMLAnchorElement[]>()
      for (const link of links) {
        const targetId = link.getAttribute("href")?.replace("#", "")
        if (!targetId) continue
        const bucket = linksById.get(targetId)
        if (bucket) bucket.push(link as HTMLAnchorElement)
        else linksById.set(targetId, [link as HTMLAnchorElement])
      }
      // Card subnav: bucket sub-links by their target card id and keep a
      // map from section id to the cards it contains (in DOM order).
      const subLinksByCardId = new Map<string, HTMLAnchorElement[]>()
      const cardsBySectionId = new Map<string, HTMLElement[]>()
      for (const link of subnavLinks) {
        const cardId = link.getAttribute("href")?.replace("#", "")
        if (!cardId) continue
        const bucket = subLinksByCardId.get(cardId)
        if (bucket) bucket.push(link)
        else subLinksByCardId.set(cardId, [link])
        const cardEl = document.getElementById(cardId)
        if (!cardEl) continue
        const ownerSection = cardEl.closest<HTMLElement>("section.settings-group[id]")
        if (!ownerSection) continue
        const cards = cardsBySectionId.get(ownerSection.id)
        if (cards) {
          if (!cards.includes(cardEl)) cards.push(cardEl)
        } else {
          cardsBySectionId.set(ownerSection.id, [cardEl])
        }
      }

      // Platform-gated cards (Android native/default player, desktop-only
      // Discord) are conditionally rendered or hidden, so their subnav links
      // start hidden; reveal each only while its target card is actually shown.
      const conditionalItems = Array.from(
        document.querySelectorAll<HTMLLIElement>("li[data-conditional]")
      )
      const syncConditionalNav = () => {
        for (const item of conditionalItems) {
          const cardId = item.querySelector("a")?.getAttribute("href")?.replace("#", "")
          const target = cardId ? document.getElementById(cardId) : null
          item.hidden = !target || target.offsetParent === null
        }
      }
      syncConditionalNav()
      if (conditionalItems.length) {
        const settingsRoot = document.querySelector(".settings-stack") ?? document.body
        let syncQueued = false
        const observer = new MutationObserver(() => {
          if (syncQueued) return
          syncQueued = true
          requestAnimationFrame(() => {
            syncQueued = false
            syncConditionalNav()
          })
        })
        observer.observe(settingsRoot, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ["class", "hidden", "style"],
        })
      }

      const scrollEl =
        (document.querySelector("main.flex-1.min-h-0.overflow-y-auto") as HTMLElement | null) ??
        document.scrollingElement ?? document.documentElement

      let scrollLock = false
      let currentId = ""
      let currentCardId = ""

      const setActiveCard = (cardId: string) => {
        if (cardId === currentCardId) return
        currentCardId = cardId
        for (const [otherId, bucket] of subLinksByCardId) {
          const isActive = otherId === cardId
          for (const link of bucket) {
            if (isActive) link.setAttribute("aria-current", "true")
            else link.removeAttribute("aria-current")
          }
        }
      }

      const setActive = (id: string) => {
        if (id === currentId) return
        currentId = id
        for (const [otherId, bucket] of linksById) {
          const isActive = otherId === id
          for (const link of bucket) {
            if (isActive) link.setAttribute("aria-current", "true")
            else link.removeAttribute("aria-current")
          }
        }
      }
      const writeHash = (id: string) => {
        try { history.replaceState(null, "", `#${id}`) } catch {}
      }

      const pickActiveCardWithin = (sectionId: string): string => {
        const cards = cardsBySectionId.get(sectionId)
        if (!cards || cards.length === 0) return ""
        const el = scrollEl as HTMLElement
        const clientHeight = el.clientHeight
        const containerIsRoot =
          el === document.scrollingElement || el === document.documentElement
        const containerRect = containerIsRoot
          ? { top: 0, bottom: clientHeight }
          : el.getBoundingClientRect()
        // Same 22%-from-top anchor as the section spy.
        const anchorY = containerRect.top + clientHeight * 0.22
        let best = cards[0]
        let bestDistance = Infinity
        for (const card of cards) {
          const rect = card.getBoundingClientRect()
          if (rect.bottom < containerRect.top) {
            best = card
            continue
          }
          if (rect.top > containerRect.bottom) break
          const distance = Math.abs(rect.top - anchorY)
          if (distance < bestDistance) {
            bestDistance = distance
            best = card
          }
        }
        return best.id
      }

      const pickActive = (): string => {
        if (sections.length === 0) return ""
        const el = scrollEl as HTMLElement
        const scrollTop = el.scrollTop
        const clientHeight = el.clientHeight
        const scrollHeight = el.scrollHeight
        if (scrollTop + clientHeight >= scrollHeight - 4) {
          return sections[sections.length - 1].id
        }
        // Use viewport-relative rects: section.offsetTop is measured from the
        // section's offsetParent, which is not always scrollEl - on Android
        // WebView in particular the offsetParent chain differs, so offsetTop
        // doesn't line up with scrollTop and the active id sticks.
        const containerIsRoot =
          el === document.scrollingElement || el === document.documentElement
        const containerRect = containerIsRoot
          ? { top: 0, bottom: clientHeight }
          : el.getBoundingClientRect()
        const anchorY = containerRect.top + clientHeight * 0.22
        let best = sections[0]
        let bestDistance = Infinity
        for (const section of sections) {
          const rect = section.getBoundingClientRect()
          if (rect.width === 0 && rect.height === 0) continue
          if (rect.bottom < containerRect.top) continue
          if (rect.top > containerRect.bottom) break
          const distance = Math.abs(rect.top - anchorY)
          if (distance < bestDistance) {
            bestDistance = distance
            best = section
          }
        }
        return best.id
      }

      let rafScheduled = 0
      const onScroll = () => {
        if (scrollLock) return
        if (rafScheduled) return
        rafScheduled = requestAnimationFrame(() => {
          rafScheduled = 0
          const nextSection = pickActive()
          setActive(nextSection)
          setActiveCard(pickActiveCardWithin(nextSection))
        })
      }
      scrollEl.addEventListener("scroll", onScroll, { passive: true })

      const armScrollUnlock = () => {
        const QUIET_MS = 200
        const SAFETY_MS = 2500
        let released = false
        let quietTimer = 0
        const onSettleScroll = () => arm()
        const release = () => {
          if (released) return
          released = true
          if (quietTimer) clearTimeout(quietTimer)
          scrollEl.removeEventListener("scroll", onSettleScroll)
          scrollLock = false
        }
        const arm = () => {
          if (released) return
          if (quietTimer) clearTimeout(quietTimer)
          quietTimer = window.setTimeout(release, QUIET_MS)
        }
        scrollEl.addEventListener("scroll", onSettleScroll, { passive: true })
        arm()
        window.setTimeout(release, SAFETY_MS)
      }

      // Async content above a deep-link target (playlist rows, hydrating
      // islands, unhidden cards) shifts layout after the first scroll, so
      // keep re-anchoring until the page height stops changing.
      const anchorWhileSettling = (target: HTMLElement) => {
        target.scrollIntoView({ block: "start" })
        if (typeof ResizeObserver === "undefined") return
        const contentEl = scrollEl.firstElementChild ?? scrollEl
        const QUIET_MS = 250
        const SAFETY_MS = 2500
        let released = false
        let quietTimer = 0
        const release = () => {
          if (released) return
          released = true
          if (quietTimer) clearTimeout(quietTimer)
          observer.disconnect()
          scrollEl.removeEventListener("wheel", release)
          scrollEl.removeEventListener("touchstart", release)
          scrollEl.removeEventListener("pointerdown", release)
          window.removeEventListener("keydown", release)
          scrollLock = false
        }
        const observer = new ResizeObserver(() => {
          if (released) return
          target.scrollIntoView({ block: "start" })
          if (quietTimer) clearTimeout(quietTimer)
          quietTimer = window.setTimeout(release, QUIET_MS)
        })
        scrollLock = true
        observer.observe(contentEl)
        scrollEl.addEventListener("wheel", release, { passive: true })
        scrollEl.addEventListener("touchstart", release, { passive: true })
        scrollEl.addEventListener("pointerdown", release, { passive: true })
        window.addEventListener("keydown", release)
        quietTimer = window.setTimeout(release, QUIET_MS)
        window.setTimeout(release, SAFETY_MS)
      }

      for (const link of links) {
        link.addEventListener("click", (event) => {
          const targetId = link.getAttribute("href")?.replace("#", "")
          if (!targetId) return
          const target = document.getElementById(targetId)
          if (!target) return
          event.preventDefault()
          scrollLock = true
          setActive(targetId)
          // First card in this section starts as active on a section jump
          // so the subnav doesn't lag a frame behind the scroll.
          const firstCard = cardsBySectionId.get(targetId)?.[0]
          setActiveCard(firstCard?.id ?? "")
          writeHash(targetId)
          target.scrollIntoView({ behavior: "smooth", block: "start" })
          armScrollUnlock()
        })
      }

      // Card subnav links: scroll to the card, set both section + card
      // active immediately so the rail and the highlight pop without
      // waiting for the scroll-spy to catch up. If the target card is
      // a <details>, expand it so the user lands on its content rather
      // than its collapsed summary.
      for (const link of subnavLinks) {
        link.addEventListener("click", (event) => {
          const cardId = link.getAttribute("href")?.replace("#", "")
          if (!cardId) return
          const cardEl = document.getElementById(cardId)
          if (!cardEl) return
          event.preventDefault()
          scrollLock = true
          const ownerSection = cardEl.closest<HTMLElement>("section.settings-group[id]")
          if (ownerSection) setActive(ownerSection.id)
          setActiveCard(cardId)
          if (cardEl instanceof HTMLDetailsElement) cardEl.open = true
          writeHash(cardId)
          cardEl.scrollIntoView({ behavior: "smooth", block: "start" })
          armScrollUnlock()
        })
      }

      // Deep-link from URL hash, else pick from current scroll position.
      // Hash may target a section (`#settings-watching`) or a card
      // (`#card-progress-retention`). Handle both.
      const hadInitialHash = !!location.hash
      const initialHashId = location.hash?.slice(1) || ""
      if (initialHashId && linksById.has(initialHashId)) {
        setActive(initialHashId)
        setActiveCard(pickActiveCardWithin(initialHashId))
        if (hadInitialHash) {
          requestAnimationFrame(() => {
            const target = document.getElementById(initialHashId)
            if (target) anchorWhileSettling(target)
          })
        }
      } else if (initialHashId && subLinksByCardId.has(initialHashId)) {
        const cardEl = document.getElementById(initialHashId)
        const ownerSection = cardEl?.closest<HTMLElement>("section.settings-group[id]")
        if (ownerSection) setActive(ownerSection.id)
        setActiveCard(initialHashId)
        if (cardEl instanceof HTMLDetailsElement) cardEl.open = true
        requestAnimationFrame(() => {
          if (cardEl) anchorWhileSettling(cardEl)
        })
      } else {
        const initialSection = pickActive()
        setActive(initialSection)
        setActiveCard(pickActiveCardWithin(initialSection))
      }
    }
  </script>

  <script>
    import "@/scripts/settings/settings_effects.ts"
  </script>

  <script>
    import "@/scripts/settings/settings_search.ts"
  </script>
</Layout>
