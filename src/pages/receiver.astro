---
import ReceiverLayout from "@/layouts/ReceiverLayout.astro";
---

<ReceiverLayout pageTitle="Receiver">
	<div class="relative h-dvh w-full">
		<main
			id="receiver-idle"
			class="relative h-dvh w-full flex flex-col items-center justify-center gap-6 px-6 text-center">

			<div class="flex items-center gap-3">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="8 58 224 124"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					class="h-10 sm:h-12 w-auto shrink-0 text-accent">
					<path fill="none" stroke="currentColor" stroke-width="20" d="M65.6 70.2 A50 50 0 1 1 20.2 115.6" />
					<circle fill="currentColor" cx="34.6" cy="84.6" r="9" />
					<circle fill="none" stroke="currentColor" stroke-width="20" cx="170" cy="120" r="50" />
					<rect fill="currentColor" x="146.5" y="94" width="13" height="52" rx="6.5" />
					<rect fill="currentColor" x="164.5" y="102" width="13" height="36" rx="6.5" />
					<rect fill="currentColor" x="182.5" y="110" width="13" height="20" rx="6.5" />
				</svg>
				<span class="flex items-baseline text-xl sm:text-2xl tracking-[-0.02em]">
					<span class="font-semibold text-fg">Extreme&nbsp;Infini</span><span class="font-extrabold text-accent tracking-[0.04em] ml-[0.05em]">TV</span>
				</span>
			</div>

			<h1 id="receiver-device-name" class="text-2xl font-semibold text-fg">-</h1>

			<div id="receiver-addresses" class="flex flex-col gap-1 text-sm text-fg-3 tabular-nums"></div>

			<div class="flex flex-col items-center gap-2">
				<span
					data-i18n="receiver.idle.codeLabel"
					class="text-xs font-semibold uppercase tracking-[0.22em] text-fg-3">Pair code</span>
				<span
					id="receiver-pair-code"
					class="text-6xl sm:text-7xl font-semibold tracking-[0.35em] tabular-nums text-accent">------</span>
			</div>

			<p data-i18n="receiver.idle.hint" class="max-w-md text-sm text-fg-3">
				In the app on your phone or computer, choose Play on TV, then Add a device with this address and code.
			</p>

			<button id="receiver-exit" type="button" class="btn" data-i18n="receiver.idle.exit">Exit receiver</button>

			<div class="static lg:absolute lg:bottom-8 lg:right-8 mt-2 lg:mt-0 flex items-center gap-3 rounded-2xl border border-line bg-surface p-3 text-left">
				<div class="shrink-0 rounded-xl bg-white p-2">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 41 41" shape-rendering="crispEdges" aria-hidden="true" class="block size-28 sm:size-32">
						<path fill="#ffffff" d="M0 0h41v41H0z"/><path stroke="#000000" d="M4 4.5h7m2 0h1m4 0h1m1 0h1m1 0h3m2 0h1m2 0h7M4 5.5h1m5 0h1m2 0h2m1 0h1m2 0h1m2 0h1m2 0h1m4 0h1m5 0h1M4 6.5h1m1 0h3m1 0h1m1 0h4m2 0h2m3 0h4m3 0h1m1 0h3m1 0h1M4 7.5h1m1 0h3m1 0h1m1 0h2m1 0h1m6 0h2m1 0h2m1 0h1m1 0h1m1 0h3m1 0h1M4 8.5h1m1 0h3m1 0h1m1 0h5m1 0h3m3 0h4m2 0h1m1 0h3m1 0h1M4 9.5h1m5 0h1m1 0h1m2 0h1m5 0h1m1 0h1m4 0h1m1 0h1m5 0h1M4 10.5h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7M12 11.5h1m1 0h2m4 0h1m1 0h4m1 0h1M4 12.5h1m1 0h5m2 0h1m1 0h1m1 0h1m2 0h2m1 0h1m3 0h1m2 0h5M6 13.5h1m1 0h2m1 0h3m1 0h1m1 0h1m3 0h5m1 0h1m2 0h2m1 0h4M6 14.5h2m2 0h1m5 0h4m1 0h1m2 0h3m1 0h3m1 0h1m1 0h2M5 15.5h2m4 0h1m3 0h3m1 0h4m2 0h1m2 0h2m2 0h3M5 16.5h6m1 0h1m2 0h2m1 0h1m1 0h1m2 0h7m1 0h3m2 0h1M6 17.5h1m1 0h2m3 0h4m2 0h1m1 0h2m3 0h2m3 0h1m1 0h4M4 18.5h1m1 0h1m1 0h3m1 0h2m5 0h2m1 0h1m1 0h1m2 0h2m3 0h2M4 19.5h1m1 0h2m1 0h1m1 0h1m2 0h2m1 0h1m1 0h1m5 0h1m2 0h3m2 0h2M7 20.5h1m1 0h5m1 0h3m1 0h1m1 0h1m4 0h4m1 0h3m2 0h1M4 21.5h2m3 0h1m2 0h1m1 0h5m1 0h1m1 0h4m1 0h1m2 0h2m1 0h4M4 22.5h2m1 0h2m1 0h4m2 0h1m1 0h3m1 0h1m1 0h1m1 0h1m1 0h3m1 0h2M4 23.5h1m1 0h2m8 0h2m1 0h2m2 0h3m3 0h1m1 0h5M5 24.5h1m1 0h1m1 0h4m1 0h1m3 0h2m2 0h2m1 0h1m2 0h2m1 0h3m1 0h1M4 25.5h2m10 0h6m2 0h2m1 0h1m2 0h1m3 0h1m1 0h1M4 26.5h1m1 0h3m1 0h1m1 0h1m1 0h1m1 0h1m2 0h1m1 0h1m4 0h2m5 0h1M4 27.5h1m3 0h2m1 0h4m5 0h1m1 0h6m1 0h2m1 0h5M4 28.5h1m3 0h1m1 0h1m4 0h1m5 0h1m1 0h1m2 0h1m1 0h5m2 0h2M12 29.5h2m1 0h3m2 0h4m3 0h2m3 0h1m1 0h1M4 30.5h7m2 0h1m2 0h1m1 0h2m1 0h1m2 0h1m1 0h3m1 0h1m1 0h1m1 0h2M4 31.5h1m5 0h1m1 0h1m6 0h4m1 0h1m2 0h2m3 0h5M4 32.5h1m1 0h3m1 0h1m1 0h3m1 0h2m1 0h2m2 0h4m1 0h6m1 0h2M4 33.5h1m1 0h3m1 0h1m1 0h1m2 0h5m1 0h2m4 0h3m2 0h3m1 0h1M4 34.5h1m1 0h3m1 0h1m1 0h3m2 0h1m1 0h2m1 0h1m1 0h1m3 0h2m1 0h2M4 35.5h1m5 0h1m2 0h2m4 0h1m5 0h2m2 0h2m1 0h3M4 36.5h7m1 0h2m3 0h5m4 0h3m1 0h2m3 0h1"/>
					</svg>
				</div>
				<div class="flex flex-col gap-0.5">
					<p data-i18n="receiver.idle.getAppTitle" class="text-sm font-semibold text-fg">Don't have the app?</p>
					<p data-i18n="receiver.idle.getAppHint" class="text-xs text-fg-3 max-w-[16rem]">Scan to get Extreme InfiniTV for phone and desktop</p>
					<p class="text-xs text-fg-3 tabular-nums">github.com/infinitel8p/Extreme-InfiniTV</p>
				</div>
			</div>
		</main>

		<div
			id="receiver-paired-flash"
			class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-50 rounded-full border border-accent/40 bg-accent-soft px-4 py-2 text-sm text-fg"></div>

		<div id="receiver-player" class="hidden absolute inset-0 bg-black">
			<video id="receiver-video" class="h-full w-full" playsinline></video>

			<div id="receiver-title" class="hidden absolute top-4 left-4 text-sm text-fg-3 drop-shadow"></div>

			<div
				id="receiver-loading"
				data-i18n="receiver.loading"
				class="hidden absolute inset-0 flex items-center justify-center text-sm text-fg-3">Loading…</div>

			<div id="receiver-error" class="hidden absolute inset-0 flex items-center justify-center px-6">
				<div class="rounded-2xl border border-line bg-surface p-6 max-w-sm flex flex-col items-center gap-2 text-center">
					<p data-i18n="receiver.error.title" class="text-fg font-semibold">Playback failed</p>
					<p id="receiver-error-message" class="text-sm text-fg-3"></p>
					<p data-i18n="receiver.error.returning" class="text-xs text-fg-3">Returning to the pairing screen…</p>
				</div>
			</div>
		</div>
	</div>

	<script>
		import "../scripts/receiver/receiver.ts";
	</script>
</ReceiverLayout>
