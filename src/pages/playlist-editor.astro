---
import Layout from "@/layouts/Layout.astro"
import {
  IconFolderPlus,
  IconFolderSymlink,
  IconLink,
  IconArrowUp,
  IconArrowDown,
  IconArrowRight,
  IconAlertTriangle,
  IconArrowBackUp,
  IconArrowForwardUp,
  IconDotsVertical,
  IconChevronDown,
  IconTrash,
  IconX,
  IconReplace,
  IconArrowsSort,
  IconSelectAll,
  IconDeselect,
} from "@tabler/icons-svelte"
---

<Layout pageTitle="Playlist editor">
  <main
    id="editor-page-main"
    class="w-full max-w-560 mx-auto px-4 md:px-6 lg:px-8 pt-4 lg:pt-6 pb-6
      flex flex-col gap-4 lg:flex-1 lg:min-h-0">

    <!-- Not-found state: shown when ?id= doesn't resolve to a custom entry -->
    <section
      id="editor-not-found"
      class="icon-mark-host hidden flex-1 min-h-0 items-center justify-center py-10">
      <div class="flex flex-col items-center gap-3 text-center max-w-sm">
        <span class="icon-mark icon-mark--bad icon-mark--lg">
          <IconAlertTriangle aria-hidden="true" stroke={2} />
        </span>
        <h1 data-i18n="editor.notFoundTitle" class="text-base font-semibold">Playlist not found</h1>
        <p data-i18n="editor.notFoundBody" class="text-sm text-fg-3">
          This custom playlist doesn't exist or was removed.
        </p>
        <a href="/settings#settings-playlists" class="btn">
          <span data-i18n="editor.backToSettings">Back to Settings</span>
        </a>
      </div>
    </section>

    <div id="editor-main" class="hidden flex-col gap-4 lg:flex-1 lg:min-h-0">
      <!-- Header: row 1 = title + Done below xl, one row at xl+ -->
      <header class="flex flex-col gap-3 xl:flex-row xl:flex-nowrap xl:items-center">
        <div class="flex items-center gap-3 min-w-0 flex-1 xl:contents">
          <div class="flex items-center gap-2 min-w-0 flex-1">
            <input
              id="editor-title-input"
              type="text"
              class="field-input flex-1 min-w-0 max-w-md xl:max-w-sm font-semibold text-lg h-auto py-2"
              data-i18n-attr="placeholder:editor.titlePlaceholder"
              placeholder="Playlist name"
            />
            <span id="editor-channel-count" class="text-xs text-fg-3 tabular-nums shrink-0"></span>
            <span id="editor-save-status" class="text-xs text-fg-3 shrink-0"></span>
            <button id="editor-save-retry" type="button" class="hidden text-xs font-semibold text-warn hover:underline shrink-0">
              <span data-i18n="common.retry">Retry</span>
            </button>
          </div>

          <a href="/settings#settings-playlists" class="btn-primary shrink-0 xl:order-last xl:ms-auto">
            <span data-i18n="editor.done">Done</span>
          </a>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
          <button
            id="editor-undo-btn"
            type="button"
            class="btn min-h-11 min-w-11 h-11 w-11 p-0"
            disabled
            data-i18n-attr="aria-label:editor.undo;title:editor.undo"
            aria-label="Undo"
            title="Undo">
            <IconArrowBackUp aria-hidden="true" stroke={2} />
          </button>
          <button
            id="editor-redo-btn"
            type="button"
            class="btn min-h-11 min-w-11 h-11 w-11 p-0"
            disabled
            data-i18n-attr="aria-label:editor.redo;title:editor.redo"
            aria-label="Redo"
            title="Redo">
            <IconArrowForwardUp aria-hidden="true" stroke={2} />
          </button>
          <button
            id="editor-new-group-btn"
            type="button"
            class="btn shrink-0 justify-center w-11 px-0 gap-0 sm:w-auto sm:px-3.5 sm:gap-2"
            data-i18n-attr="aria-label:editor.newGroup;title:editor.newGroup"
            aria-label="New group"
            title="New group">
            <IconFolderPlus aria-hidden="true" class="btn-icon" />
            <span class="hidden sm:inline" data-i18n="editor.newGroup">New group</span>
          </button>
          <button
            id="editor-add-url-btn"
            type="button"
            class="btn shrink-0 justify-center w-11 px-0 gap-0 sm:w-auto sm:px-3.5 sm:gap-2"
            data-i18n-attr="aria-label:editor.addByUrl;title:editor.addByUrl"
            aria-label="Add by URL"
            title="Add by URL">
            <IconLink aria-hidden="true" class="btn-icon" />
            <span class="hidden sm:inline" data-i18n="editor.addByUrl">Add by URL</span>
          </button>

          <div id="editor-check-links-chip" class="hidden items-center gap-1.5 rounded-full border border-line bg-surface-2 min-h-11 px-3 text-xs text-fg-2 shrink-0">
            <span id="editor-check-links-chip-label" class="tabular-nums"></span>
            <button
              id="editor-check-links-chip-cancel"
              type="button"
              class="inline-flex items-center justify-center size-11 -me-2 rounded-full hover:bg-surface"
              data-i18n-attr="aria-label:common.cancel"
              aria-label="Cancel">
              <IconX aria-hidden="true" stroke={2} />
            </button>
          </div>

          <button
            id="editor-toolbar-more-btn"
            type="button"
            class="btn min-h-11 min-w-11 h-11 w-11 p-0"
            data-i18n-attr="aria-label:livetv.moreActions"
            aria-label="More actions">
            <IconDotsVertical aria-hidden="true" stroke={2} />
          </button>
        </div>
      </header>

      <datalist id="editor-groups-datalist"></datalist>

      <!-- Pane switcher: below lg only, one pane visible at a time -->
      <div
        id="editor-pane-switcher"
        role="tablist"
        class="lg:hidden grid grid-cols-2 gap-1 p-1 rounded-xl border border-line bg-surface">
        <button
          id="editor-pane-tab-source"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="editor-source-pane"
          tabindex="-1"
          class="min-h-11 rounded-lg text-sm font-medium text-fg-2 transition-colors">
          <span data-i18n="editor.sourceBrowser">Add channels from</span>
        </button>
        <button
          id="editor-pane-tab-playlist"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="editor-playlist-pane"
          tabindex="0"
          class="min-h-11 rounded-lg text-sm font-medium bg-accent-soft text-accent ring-1 ring-accent/30 transition-colors">
          <span data-i18n="editor.yourPlaylist">Your playlist</span>
        </button>
      </div>

      <div id="editor-panes" data-active-pane="playlist" class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:flex-1 lg:min-h-0">
        <!-- LEFT: source browser -->
        <section
          id="editor-source-pane"
          role="tabpanel"
          aria-labelledby="editor-pane-tab-source"
          class="rounded-2xl border border-line bg-surface p-4 flex flex-col gap-3 lg:min-h-0">
          <h2 data-i18n="editor.sourceBrowser" class="text-sm font-semibold">Add channels from</h2>

          <label class="flex flex-col gap-1.5">
            <span class="sr-only" data-i18n="editor.sourceSelectLabel">Source playlist</span>
            <select id="editor-source-select" class="field-input"></select>
          </label>

          <div class="flex flex-wrap gap-2">
            <label class="flex-1 min-w-0">
              <span class="sr-only" data-i18n="list.searchChannels">Search channels</span>
              <input
                id="editor-source-search"
                type="search"
                class="field-input"
                data-i18n-attr="placeholder:editor.searchPlaceholder"
                placeholder="Search channels…"
              />
            </label>
            <label class="w-36 shrink-0">
              <span class="sr-only" data-i18n="editor.categoryFilterLabel">Category</span>
              <select id="editor-source-category" class="field-input"></select>
            </label>
            <label class="w-36 shrink-0">
              <span class="sr-only" data-i18n="editor.sourceSortLabel">Sort</span>
              <select id="editor-source-sort" class="field-input">
                <option value="default" data-i18n="editor.sourceSortDefault">Provider order</option>
                <option value="az" data-i18n="editor.sortAz">Sort A-Z</option>
                <option value="za" data-i18n="editor.sortZa">Sort Z-A</option>
              </select>
            </label>
          </div>

          <div class="flex items-center gap-2">
            <button id="editor-source-select-all-btn" type="button" class="btn shrink-0 justify-center gap-2 px-3.5">
              <IconSelectAll aria-hidden="true" class="btn-icon" />
              <span data-i18n="editor.sourceSelectAll">Select all</span>
            </button>
            <button id="editor-source-deselect-all-btn" type="button" class="btn shrink-0 justify-center gap-2 px-3.5">
              <IconDeselect aria-hidden="true" class="btn-icon" />
              <span data-i18n="editor.sourceDeselectAll">Deselect all</span>
            </button>
          </div>

          <div
            id="editor-source-list"
            class="relative max-h-[60dvh] lg:max-h-none lg:flex-1 lg:min-h-0 overflow-y-auto custom-scroll rounded-xl border border-line bg-bg">
            <div id="editor-source-spacer" class="relative w-full"></div>
            <div id="editor-source-viewport" class="absolute inset-x-0 top-0"></div>
            <p id="editor-source-empty" class="hidden p-6 text-center text-sm text-fg-3"></p>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <span id="editor-source-selected-count" class="text-xs text-fg-3 tabular-nums shrink-0"></span>
            <label class="flex-1 min-w-32">
              <span class="sr-only" data-i18n="editor.targetGroupPlaceholder">Target group (optional)</span>
              <input
                id="editor-source-target-group"
                type="text"
                class="field-input"
                list="editor-groups-datalist"
                data-i18n-attr="placeholder:editor.targetGroupPlaceholder"
                placeholder="Target group (optional)"
              />
            </label>
            <button id="editor-add-selected-btn" type="button" class="btn-primary shrink-0" disabled>
              <IconArrowRight aria-hidden="true" class="btn-icon" />
              <span data-i18n="editor.addSelected">Add selected</span>
            </button>
          </div>
        </section>

        <!-- RIGHT: playlist -->
        <section
          id="editor-playlist-pane"
          role="tabpanel"
          aria-labelledby="editor-pane-tab-playlist"
          class="rounded-2xl border border-line bg-surface p-4 flex flex-col gap-3 lg:min-h-0">
          <h2 data-i18n="editor.yourPlaylist" class="text-sm font-semibold">Your playlist</h2>

          <div
            id="editor-bulk-actions-bar"
            class="hidden items-center gap-2 flex-wrap rounded-xl border border-line bg-surface-2 px-3 py-2">
            <span id="editor-selected-count" class="text-xs font-medium text-fg-2 tabular-nums shrink-0"></span>
            <div class="flex items-center gap-2 flex-wrap ms-auto">
              <button
                id="editor-bulk-move-up-btn"
                type="button"
                class="btn min-h-11 min-w-11 h-11 w-11 p-0"
                data-i18n-attr="aria-label:editor.moveUp;title:editor.moveUp"
                aria-label="Move up"
                title="Move up">
                <IconArrowUp aria-hidden="true" stroke={2} />
              </button>
              <button
                id="editor-bulk-move-down-btn"
                type="button"
                class="btn min-h-11 min-w-11 h-11 w-11 p-0"
                data-i18n-attr="aria-label:editor.moveDown;title:editor.moveDown"
                aria-label="Move down"
                title="Move down">
                <IconArrowDown aria-hidden="true" stroke={2} />
              </button>
              <button id="editor-bulk-move-to-group-btn" type="button" class="btn shrink-0 justify-center gap-2 px-3.5">
                <IconFolderSymlink aria-hidden="true" class="btn-icon" />
                <span data-i18n="editor.moveToGroupLabel">Move to group</span>
              </button>
              <button id="editor-bulk-more-btn" type="button" class="btn shrink-0 justify-center gap-2 px-3.5">
                <IconArrowsSort aria-hidden="true" class="btn-icon" />
                <span data-i18n="editor.moreActions">More</span>
              </button>
              <button id="editor-bulk-remove-btn" type="button" class="btn-danger shrink-0 justify-center gap-2 px-3.5">
                <IconTrash aria-hidden="true" class="btn-icon" />
                <span data-i18n="editor.removeSelected">Remove</span>
              </button>
              <button
                id="editor-bulk-clear-btn"
                type="button"
                class="btn min-h-11 min-w-11 h-11 w-11 p-0"
                data-i18n-attr="aria-label:editor.clearSelection;title:editor.clearSelection"
                aria-label="Clear selection"
                title="Clear selection">
                <IconX aria-hidden="true" stroke={2} />
              </button>
            </div>
          </div>

          <div id="editor-groups" class="flex flex-col gap-4 pr-1 lg:flex-1 lg:min-h-0 lg:overflow-y-auto custom-scroll"></div>
          <div id="editor-empty-state" class="hidden flex-col items-center gap-3 text-center py-10">
            <p data-i18n="editor.emptyState" class="text-sm text-fg-3 max-w-sm">
              No channels yet. Add channels from another playlist or by URL.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-2">
              <button id="editor-empty-add-url-btn" type="button" class="btn">
                <IconLink aria-hidden="true" class="btn-icon" />
                <span data-i18n="editor.addByUrl">Add by URL</span>
              </button>
              <button id="editor-empty-source-btn" type="button" class="btn lg:hidden">
                <span data-i18n="editor.sourceBrowser">Add channels from</span>
              </button>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <!-- New group dialog -->
  <dialog
    id="editor-new-group-dialog"
    aria-labelledby="editor-new-group-title"
    class="fixed inset-0 m-auto rounded-2xl border border-line bg-surface text-fg p-0
      w-[min(24rem,calc(100vw-2rem))] backdrop:bg-black/60">
    <form method="dialog" class="flex flex-col gap-4 p-5">
      <header class="flex items-center gap-3">
        <span class="icon-mark" aria-hidden="true">
          <IconFolderPlus aria-hidden="true" stroke={2} />
        </span>
        <h2 id="editor-new-group-title" data-i18n="editor.newGroupDialogTitle" class="text-base font-semibold">
          New group
        </h2>
      </header>
      <label class="flex flex-col gap-1.5">
        <span data-i18n="editor.newGroupNameLabel" class="text-sm font-medium text-fg-2">
          Group name
        </span>
        <input
          id="editor-new-group-name"
          type="text"
          class="field-input"
          data-i18n-attr="placeholder:editor.groupNamePlaceholder"
          placeholder="Group name"
        />
      </label>
      <div class="flex gap-2 justify-end">
        <button type="button" data-role="cancel" class="btn">
          <span data-i18n="common.cancel">Cancel</span>
        </button>
        <button type="submit" data-role="create" class="btn-primary">
          <span data-i18n="editor.newPlaylistCreate">Create</span>
        </button>
      </div>
    </form>
  </dialog>

  <!-- Add by URL dialog -->
  <dialog
    id="editor-add-url-dialog"
    aria-labelledby="editor-add-url-title"
    class="fixed inset-0 m-auto rounded-2xl border border-line bg-surface text-fg p-0
      w-[min(30rem,calc(100vw-2rem))] max-h-[min(85dvh,42rem)] open:flex flex-col overflow-hidden backdrop:bg-black/60">
    <form method="dialog" class="flex flex-col flex-auto min-h-0 p-5 gap-4 overflow-y-auto custom-scroll">
      <header class="flex items-start gap-3">
        <span class="icon-mark" aria-hidden="true">
          <IconLink aria-hidden="true" stroke={2} />
        </span>
        <div class="flex flex-col gap-1 min-w-0">
          <h2 id="editor-add-url-title" data-i18n="editor.addUrlDialogTitle" class="text-base font-semibold">
            Add by URL
          </h2>
          <p data-i18n="editor.addUrlDialogSubtitle" class="text-xs text-fg-3">
            Add a direct stream URL as a channel in this playlist.
          </p>
        </div>
      </header>

      <label class="flex flex-col gap-1.5">
        <span data-i18n="editor.urlLabel" class="text-sm font-medium text-fg-2">
          Stream URL
        </span>
        <input
          id="editor-url-url"
          type="text"
          inputmode="url"
          autocapitalize="off"
          spellcheck="false"
          class="field-input"
          data-i18n-attr="placeholder:editor.urlPlaceholder"
          placeholder="https://example.com/stream.m3u8"
        />
        <span id="editor-url-error" class="hidden text-xs text-bad"></span>
      </label>

      <div class="grid grid-cols-2 gap-3">
        <label class="flex flex-col gap-1.5">
          <span data-i18n="editor.nameLabel" class="text-sm font-medium text-fg-2">Name</span>
          <input id="editor-url-name" type="text" class="field-input" />
        </label>
        <label class="flex flex-col gap-1.5">
          <span data-i18n="editor.groupLabel" class="text-sm font-medium text-fg-2">Group</span>
          <input id="editor-url-group" type="text" class="field-input" list="editor-groups-datalist" />
        </label>
      </div>

      <label class="flex flex-col gap-1.5">
        <span data-i18n="editor.logoLabel" class="text-sm font-medium text-fg-2">Logo URL</span>
        <input id="editor-url-logo" type="text" class="field-input" />
      </label>

      <details class="rounded-xl border border-line bg-bg">
        <summary
          class="flex min-h-11 cursor-pointer select-none items-center justify-between gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-surface-2">
          <span data-i18n="editor.advancedLabel" class="text-sm font-medium text-fg-2">Advanced</span>
          <IconChevronDown aria-hidden="true" class="size-4 shrink-0 text-fg-3" />
        </summary>
        <div class="flex flex-col gap-4 px-3 pb-3 pt-1">
          <div class="grid grid-cols-2 gap-3">
            <label class="flex flex-col gap-1.5">
              <span data-i18n="editor.userAgentLabel" class="text-sm font-medium text-fg-2">
                Player identity (User-Agent)
              </span>
              <input id="editor-url-ua" type="text" class="field-input" />
            </label>
            <label class="flex flex-col gap-1.5">
              <span data-i18n="editor.refererLabel" class="text-sm font-medium text-fg-2">
                Referring page (Referer)
              </span>
              <input id="editor-url-referer" type="text" class="field-input" />
            </label>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <label class="flex flex-col gap-1.5">
              <span data-i18n="editor.manifestTypeLabel" class="text-sm font-medium text-fg-2">
                Stream type
              </span>
              <select id="editor-url-manifest" class="field-input">
                <option value="" data-i18n="editor.manifestTypeAuto">Auto</option>
                <option value="hls" data-i18n="editor.manifestTypeHls">HLS</option>
                <option value="mpd" data-i18n="editor.manifestTypeDash">MPEG-DASH</option>
              </select>
            </label>
            <label class="flex flex-col gap-1.5">
              <span data-i18n="editor.licenseKeyLabel" class="text-sm font-medium text-fg-2">
                Decryption key (ClearKey KID:KEY)
              </span>
              <input id="editor-url-license" type="text" class="field-input" />
            </label>
          </div>

          <a href="/docs?p=custom-playlists" class="self-start text-xs text-accent hover:underline focus-visible:underline focus-visible:outline-none">
            <span data-i18n="common.learnMore">Learn more</span>
          </a>
        </div>
      </details>

      <div class="flex gap-2 justify-end mt-auto pt-2">
        <button type="button" data-role="cancel" class="btn">
          <span data-i18n="common.cancel">Cancel</span>
        </button>
        <button type="submit" data-role="add" class="btn-primary">
          <span data-i18n="editor.addUrlSubmit">Add channel</span>
        </button>
      </div>
    </form>
  </dialog>

  <!-- Bulk rename (find & replace) dialog -->
  <dialog
    id="editor-bulk-rename-dialog"
    aria-labelledby="editor-bulk-rename-title"
    class="fixed inset-0 m-auto rounded-2xl border border-line bg-surface text-fg p-0
      w-[min(26rem,calc(100vw-2rem))] backdrop:bg-black/60">
    <form method="dialog" class="flex flex-col gap-4 p-5">
      <header class="flex items-start gap-3">
        <span class="icon-mark" aria-hidden="true">
          <IconReplace aria-hidden="true" stroke={2} />
        </span>
        <div class="flex flex-col gap-1 min-w-0">
          <h2 id="editor-bulk-rename-title" data-i18n="editor.bulkRenameDialogTitle" class="text-base font-semibold">
            Find &amp; replace
          </h2>
          <p data-i18n="editor.bulkRenameDialogSubtitle" class="text-xs text-fg-3">
            Replace text in channel names across the whole playlist.
          </p>
        </div>
      </header>
      <label class="flex flex-col gap-1.5">
        <span data-i18n="editor.bulkRenameFindLabel" class="text-sm font-medium text-fg-2">
          Find
        </span>
        <input id="editor-bulk-rename-find" type="text" class="field-input" />
      </label>
      <label class="flex flex-col gap-1.5">
        <span data-i18n="editor.bulkRenameReplaceLabel" class="text-sm font-medium text-fg-2">
          Replace with
        </span>
        <input id="editor-bulk-rename-replace" type="text" class="field-input" />
      </label>
      <label class="flex items-center gap-2 text-sm">
        <input id="editor-bulk-rename-matchcase" type="checkbox" class="size-4" />
        <span data-i18n="editor.bulkRenameMatchCaseLabel">Match case</span>
      </label>
      <p id="editor-bulk-rename-preview" class="text-xs text-fg-3"></p>
      <div id="editor-bulk-rename-preview-sample" class="hidden flex-col gap-0.5 rounded-lg border border-line bg-bg px-3 py-2 text-xs text-fg-2"></div>
      <div class="flex gap-2 justify-end">
        <button type="button" data-role="cancel" class="btn">
          <span data-i18n="common.cancel">Cancel</span>
        </button>
        <button type="submit" data-role="submit" class="btn-primary" disabled>
          <span data-i18n="editor.bulkRenameSubmit">Replace all</span>
        </button>
      </div>
    </form>
  </dialog>

  <script>
    import "@/scripts/editor/editor.ts"
  </script>
</Layout>

<style>
  #editor-main.flex,
  #editor-empty-state.flex,
  #editor-bulk-rename-preview-sample.flex,
  #editor-check-links-chip.flex,
  #editor-bulk-actions-bar.flex {
    display: flex;
  }

  .editor-channel-row {
    content-visibility: auto;
    contain-intrinsic-size: 56px;
  }

  .editor-channel-row[draggable="true"] {
    cursor: grab;
  }
  .editor-channel-row[data-dragging="true"] {
    opacity: 0.4;
  }
  .editor-channel-row[data-selected="true"] {
    background: color-mix(in oklch, var(--color-accent) 10%, transparent);
    border-color: color-mix(in oklch, var(--color-accent) 40%, var(--color-line));
  }
  .editor-group[data-drop-target="true"],
  .editor-group-header[data-drop-target="true"],
  .editor-channel-row[data-drop-target="true"] {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  /* Floating clone that follows the finger during touch long-press reorder. Appended straight to
     document.body, so it never gets Astro's scoped attribute: needs :global(). */
