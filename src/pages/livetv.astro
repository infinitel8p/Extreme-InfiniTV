---
import Layout from "@/layouts/Layout.astro";
import SearchInput from "@/components/SearchInput.astro";
import SortMenu from "@/components/SortMenu.astro";
import CategoryPickerDialog from "@/components/CategoryPickerDialog.astro";
import WelcomeCard from "@/components/WelcomeCard.astro";
import { IconDeviceTv, IconChevronDown, IconCalendarTime, IconLayoutGrid } from "@tabler/icons-svelte";
---

<Layout pageTitle="Live TV">
	<script is:inline>
		try {
			var raw = localStorage.getItem("xt_playlists") || "";
			var hasEntries = false;
			if (raw) {
				var parsed = JSON.parse(raw);
				hasEntries = !!(
					parsed &&
					Array.isArray(parsed.entries) &&
					parsed.entries.length
				);
			}
			if (!hasEntries) {
				document.documentElement.setAttribute("data-first-run", "true");
			}
		} catch (e) {}
	</script>

	<main
		id="livetv-page-main"
		class="w-full max-w-480 mx-auto px-4 md:px-6 lg:px-8 pt-4 lg:pt-6 md:landscape:pt-6 pb-6
			flex flex-col gap-4 flex-1 min-h-0">

		<section
			id="livetv-welcome"
			aria-labelledby="welcome-heading"
			class="livetv-welcome hidden flex-1 min-h-0 items-center justify-center py-6">
			<WelcomeCard />
		</section>

		<section
			id="livetv-main"
			class="flex flex-col md:landscape:flex-row lg:flex-row gap-4 flex-1 min-h-0">

			<!-- Channels (bottom on mobile, left column on desktop) -->
			<aside
				class="order-2 md:landscape:order-1 lg:order-1
					md:landscape:w-(--xt-channels-w,24rem) lg:w-(--xt-channels-w,28rem)
					md:landscape:shrink-0 lg:shrink-0 md:landscape:min-h-0 lg:min-h-0">
				<div
					class="rounded-2xl border border-line bg-surface p-3 h-full flex flex-col gap-3 md:landscape:min-h-0 lg:min-h-0">

					<div class="flex gap-2 shrink-0">
						<button
							id="category-picker-trigger"
							type="button"
							aria-haspopup="dialog"
							aria-controls="category-picker-dialog"
							class="rounded-xl border border-line bg-bg px-3.5 py-2 min-h-11 text-sm flex items-center gap-2 text-left flex-1 min-w-0
								hover:bg-surface-2 focus-visible:bg-surface-2 focus-visible:border-accent
								transition-colors">
							<span data-i18n="list.category" class="text-fg-3 shrink-0">Category</span>
							<span
								id="category-picker-label"
								data-i18n="list.allCategories"
								class="text-fg truncate flex-1">All categories</span>
							<IconChevronDown
								aria-hidden="true"
								stroke={2}
								class="size-4 text-fg-3 shrink-0"
							/>
						</button>
						<button
							id="epg-toggle"
							type="button"
							aria-pressed="true"
							aria-label="Show EPG for the current channel"
							title="Show EPG"
							data-i18n-attr="aria-label:livetv.epgToggle.aria;title:livetv.epgToggle.title"
							class="rounded-xl border border-line bg-bg px-3.5 py-2 min-h-11 min-w-11 text-sm text-fg-2 inline-flex items-center justify-center gap-2 shrink-0
								hover:bg-surface-2 focus-visible:bg-surface-2 focus-visible:border-accent
								aria-pressed:border-accent aria-pressed:bg-surface-2 aria-pressed:text-fg
								transition-colors">
							<IconCalendarTime
								aria-hidden="true"
								stroke={2}
								class="size-4"
							/>
							<span data-i18n="livetv.epgPanelHeading" class="hidden sm:inline">EPG</span>
						</button>
						<a
							href="/epg"
							aria-label="Open the full EPG schedule grid"
							title="Open schedule grid"
							data-i18n-attr="aria-label:livetv.openSchedule.aria;title:livetv.openSchedule.title"
							class="rounded-xl border border-line bg-bg px-3.5 py-2 min-h-11 min-w-11 text-sm text-fg-2 inline-flex items-center justify-center shrink-0
								hover:bg-surface-2 focus-visible:bg-surface-2 focus-visible:border-accent
								transition-colors">
							<IconLayoutGrid
								aria-hidden="true"
								stroke={2}
								class="size-4"
							/>
							<span data-i18n="livetv.openSchedule.label" class="sr-only">Schedule grid</span>
						</a>
					</div>

					<div class="flex gap-2 shrink-0">
						<div class="flex-1 min-w-0">
							<SearchInput
								id="search"
								label="Search channels"
								placeholder="Search channels…"
								clearButtonId="clear-search"
								labelKey="list.searchChannels"
								placeholderKey="list.searchChannelsPlaceholder"
								clearKey="common.clear"
							/>
						</div>
						<SortMenu
							id="channel-sort"
							widthClass="w-40 shrink-0"
							options={[
								{ value: "default", label: "Source order", key: "sort.sourceOrder" },
								{ value: "number", label: "Channel number", key: "sort.channelNumber" },
								{ value: "az", label: "A-Z", key: "sort.az" },
								{ value: "za", label: "Z-A", key: "sort.za" },
								{ value: "cataz", label: "Category, A-Z", key: "sort.categoryAz" },
							]}
						/>
					</div>

					<div
						id="list"
						class="relative flex-1 min-h-0 overflow-auto pr-1 custom-scroll
							max-h-96 md:landscape:max-h-dvh lg:max-h-dvh">
						<div id="spacer"></div>
						<div id="viewport" class="absolute inset-x-0 top-0"></div>
					</div>

					<div
						id="list-status"
						data-i18n="list.noPlaylistSelected"
						class="px-2.5 text-sm text-fg-3 tabular-nums shrink-0">
						No playlist selected.
					</div>
				</div>
			</aside>

			<!-- Player + EPG (top on mobile, right column on desktop/landscape) -->
			<section
				class="order-1 md:landscape:order-2 lg:order-2
					md:landscape:flex-1 lg:flex-1 min-w-0 md:landscape:min-h-0 lg:min-h-0">
				<div
					class="rounded-2xl border border-line bg-surface p-3 h-full flex flex-col gap-3 md:landscape:min-h-0 lg:min-h-0">
					<div
						id="player-wrap"
						class="player-wrap aspect-video w-full mx-auto overflow-hidden rounded-xl bg-black ring-1 ring-line flex items-center justify-center shrink-0 relative">
						<div
							id="player-empty"
							class="absolute inset-0 flex flex-col items-center justify-center gap-6 text-center px-6 pointer-events-none">
							<div class="player-empty-glow" aria-hidden="true"></div>
							<IconDeviceTv
								aria-hidden="true"
								stroke={0.6}
								class="size-24 sm:size-28 lg:size-36 text-fg-3/55 relative z-10"
							/>
							<div class="flex flex-col gap-2.5 relative z-10">
								<span class="inline-flex items-center gap-2 self-center text-eyebrow font-semibold uppercase tracking-[0.22em] text-fg-3">
									<span aria-hidden="true" class="size-1.5 rounded-full bg-accent shadow-[0_0_0_4px_var(--color-accent-soft)]"></span>
									<span data-i18n="livetv.idle">Idle</span>
								</span>
								<p data-i18n="livetv.pickChannel" class="text-fg leading-[0.95] tracking-[-0.03em] font-bold"
									style="font-size: clamp(1.75rem, 3vw + 1rem, 3.5rem);">
									Pick a channel.
								</p>
								<p data-i18n="livetv.pickChannelHelper" class="text-fg-3 text-xs sm:text-sm">
									Choose from the list, or change category.
								</p>
							</div>
						</div>
						<video
							id="player"
							class="video-js vjs-default-skin vjs-big-play-centered h-full w-full"
							controls
							hidden
							playsinline></video>
						<div
							id="radio-display"
							class="radio-display max-[480px]:flex-col max-[480px]:text-center max-[480px]:items-center"
							aria-hidden="true">
							<div
								class="radio-display__art relative shrink-0 aspect-square rounded-2xl bg-surface-2 overflow-hidden"
								data-radio-art>
								<div class="radio-display__art-fallback absolute inset-0 grid place-items-center" aria-hidden="true">
									<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 17a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/><path d="M13 17a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/><path d="M9 17v-13h10v13"/><path d="M9 8h10"/></svg>
								</div>
								<img
									alt=""
									decoding="async"
									referrerpolicy="no-referrer"
									data-radio-cover
									class="absolute inset-0 w-full h-full object-contain p-3 opacity-0 data-[loaded=true]:opacity-100 transition-opacity duration-240 ease-[cubic-bezier(0.16,1,0.3,1)]" />
							</div>
							<div class="radio-display__meta flex flex-col gap-2 min-w-0 flex-1 pb-14 max-[480px]:items-center max-[480px]:pb-16">
								<span
									class="radio-display__eyebrow inline-flex items-center gap-2 text-fg-3 text-[0.625rem] font-semibold uppercase tracking-[0.22em]"
									data-i18n="livetv.radioEyebrow"
								>On air · Radio</span>
								<p
									class="radio-display__name text-fg font-bold tracking-tight leading-tight min-w-0 line-clamp-2 text-[clamp(1.5rem,3vw,2.25rem)]"
									data-radio-name>-</p>
								<p
									class="radio-display__nowplaying text-fg-2 text-sm m-0 min-w-0 line-clamp-2"
									data-radio-nowplaying
									hidden></p>
								<p
									class="radio-display__desc text-fg-3 text-sm m-0 min-w-0 line-clamp-1 max-[480px]:hidden"
									data-radio-desc
									hidden></p>
								<div
									class="radio-display__meta-row flex flex-wrap items-center gap-x-3 gap-y-2 mt-1 max-[480px]:justify-center"
									data-radio-metarow
									hidden>
									<span class="radio-tags flex flex-wrap items-center gap-2" data-radio-tags></span>
									<span
										class="radio-elapsed inline-flex items-center gap-1.5 text-fg-3 text-xs"
										data-radio-elapsed
										hidden>
										<span data-i18n="livetv.radioListening">Listening</span>
										<span class="tabular-nums text-fg-2" data-radio-elapsed-time>0:00</span>
									</span>
								</div>
							</div>
						</div>

					</div>

					<div
						id="current"
						class="flex items-center justify-between gap-2 px-1 text-sm text-fg-2 shrink-0">
						<div class="flex items-center gap-2 min-w-0">
							<span data-i18n="livetv.statusOff" class="status-badge status-badge--off shrink-0">OFF</span>
							<span class="truncate">-</span>
						</div>
					</div>

					<div
						id="epg"
						data-epg-collapsed="true"
						class="border-t border-line overflow-auto custom-scroll md:landscape:flex-1 md:landscape:min-h-0 lg:flex-1 lg:min-h-0">
						<div class="flex items-center justify-between gap-2 text-sm font-medium text-fg sticky top-0 bg-surface pt-3 pb-2 z-10">
							<span data-i18n="livetv.epgPanelHeading" class="ps-1">EPG</span>
							<div class="flex items-center gap-1 pe-1">
								<span id="epg-day-indicator" class="text-2xs font-semibold uppercase tracking-wide text-fg-3"></span>
								<button
									id="epg-expand-toggle"
									type="button"
									aria-expanded="false"
									aria-label="Show full guide"
									data-label-expand="Show full guide"
									data-label-collapse="Show now playing only"
									data-i18n-attr="aria-label:livetv.epgListExpand;data-label-expand:livetv.epgListExpand;data-label-collapse:livetv.epgListCollapse"
									class="group md:landscape:hidden lg:hidden -my-1.5 inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg text-fg-3
										hover:bg-surface-2 hover:text-fg focus-visible:bg-surface-2 focus-visible:text-fg
										outline-none focus-visible:ring-1 focus-visible:ring-accent
										transition-colors">
									<IconChevronDown
										aria-hidden="true"
										stroke={2}
										class="size-4 transition-transform duration-200 group-aria-expanded:rotate-180"
									/>
								</button>
							</div>
						</div>
						<div id="epg-list" class="space-y-2 text-sm px-1 pb-3"></div>
					</div>
				</div>
			</section>
		</section>

		<!-- Categories popover -->
		<CategoryPickerDialog idPrefix="category-picker" />
	</main>

	<style>
		html[data-first-run="true"] #livetv-main { display: none; }
		html[data-first-run="true"] #livetv-welcome { display: flex; }
		html[data-first-run="true"] #livetv-page-main { min-height: auto; }

		.player-wrap {
			max-height: 60dvh;
			max-width: calc(60dvh * 16 / 9);
		}

		/* Radio mode */
		.radio-display { display: none; }
		.player-wrap[data-radio-mode="on"] {
			aspect-ratio: auto;
			max-height: none;
			max-width: 100%;
			height: auto;
			min-height: clamp(14rem, 28dvh, 22rem);
			background:
				radial-gradient(
					120% 80% at 50% 0%,
					color-mix(in oklch, var(--color-accent) 24%, transparent) 0%,
					transparent 60%
				),
				linear-gradient(180deg, var(--color-surface-2), var(--color-surface));
			padding: clamp(1rem, 3vw, 2rem);
			gap: clamp(1rem, 3vw, 2rem);
			justify-content: flex-start;
		}
		.player-wrap[data-radio-mode="on"] #player-empty { display: none !important; }
		.player-wrap[data-radio-mode="on"] .radio-display {
			display: flex;
			align-items: center;
			gap: clamp(1rem, 3vw, 2rem);
			width: 100%;
			min-width: 0;
		}
		/* Collapse the player to a thin control strip at the bottom so the radio
		   panel is visible above it. The player internals are created at runtime by
		   video.js / artplayer / shaka, so they carry no Astro scope attribute -
		   these selectors must be :global() or they never match. !important +
		   overflow also beat artplayer's inline width/height:100% on its container. */
		.player-wrap[data-radio-mode="on"] :global(.video-js),
		.player-wrap[data-radio-mode="on"] :global(#player),
		.player-wrap[data-radio-mode="on"] :global(.art-video-player) {
			position: absolute !important;
			inset: auto 0 0 0 !important;
			width: 100% !important;
			height: 3.25rem !important;
			padding-top: 0 !important;
			background: transparent !important;
			overflow: visible !important;
		}
		/* Let control-bar tooltips overflow the one-control-tall strip upward. */
		.player-wrap[data-radio-mode="on"] :global(.art-bottom),
		.player-wrap[data-radio-mode="on"] :global(.art-controls) {
			overflow: visible !important;
		}
		.player-wrap[data-radio-mode="on"] :global(.vjs-tech),
		.player-wrap[data-radio-mode="on"] :global(#player video),
		.player-wrap[data-radio-mode="on"] :global(.vjs-poster),
		.player-wrap[data-radio-mode="on"] :global(.art-video),
		.player-wrap[data-radio-mode="on"] :global(.art-poster),
		.player-wrap[data-radio-mode="on"] :global(.art-mask),
		.player-wrap[data-radio-mode="on"] :global(.art-layers),
		.player-wrap[data-radio-mode="on"] :global(.art-loading) {
			display: none !important;
		}
		.player-wrap[data-radio-mode="on"] :global(.vjs-control-bar) {
			background: color-mix(in oklch, var(--color-bg) 70%, transparent);
			border-top: 1px solid var(--color-line);
			border-radius: 0 0 0.75rem 0.75rem;
		}
		/* artplayer keeps its control bar mounted (only the icons fade) and paints
		   several black layers - force every surface transparent so the collapsed
		   strip blends into the panel gradient and only the control icons reveal. */
		.player-wrap[data-radio-mode="on"] :global(.art-video-player),
		.player-wrap[data-radio-mode="on"] :global(.art-video-player *:not(.art-volume-panel):not(.art-volume-panel *)) {
			background: transparent !important;
			border: 0 !important;
			box-shadow: none !important;
		}
		/* The strip has no dark video behind it, so give the volume panel its own legible surface in both themes. */
		.player-wrap[data-radio-mode="on"] :global(.art-volume-panel .art-volume-inner) {
			background: rgba(15, 18, 25, 0.94);
			border: 1px solid rgba(255, 255, 255, 0.14);
			border-radius: 0.625rem;
			box-shadow: 0 10px 28px -10px rgba(0, 0, 0, 0.7);
			-webkit-backdrop-filter: blur(8px);
			backdrop-filter: blur(8px);
		}
		/* Shaka sets the container height inline, so this needs !important to win. */
		.player-wrap[data-radio-mode="on"] :global(.shaka-video-container) {
			height: 3.25rem !important;
		}
		.player-wrap[data-radio-mode="on"] :global(.shaka-bottom-controls) {
			background: color-mix(in oklch, var(--color-bg) 70%, transparent);
			border-top: 1px solid var(--color-line);
			border-radius: 0 0 0.75rem 0.75rem;
		}

		.radio-display__art {
			width: clamp(7rem, 16vw, 11rem);
			box-shadow:
				0 0 0 1px var(--color-line),
				0 0 40px 8px color-mix(in oklch, var(--color-accent) 38%, transparent),
				0 8px 20px -6px oklch(0.13 0.02 265 / 0.5);
		}
		.radio-display__art-fallback {
			color: color-mix(in oklch, var(--color-fg-3) 80%, transparent);
		}
		.radio-display__eyebrow::before {
			content: "";
			width: 0.375rem;
			height: 0.375rem;
			border-radius: 999px;
			background: var(--color-accent);
			animation: radio-onair-pulse 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
		}
		@keyframes radio-onair-pulse {
			0%        { box-shadow: 0 0 0 0 color-mix(in oklch, var(--color-accent) 45%, transparent); }
			70%, 100% { box-shadow: 0 0 0 0.5rem transparent; }
		}
		@media (prefers-reduced-motion: reduce) {
			.radio-display__eyebrow::before {
				animation: none;
				box-shadow: 0 0 0 4px var(--color-accent-soft);
			}
		}
		:global(html[data-perf-mode="on"]) .radio-display__eyebrow::before {
			animation: none;
			box-shadow: 0 0 0 4px var(--color-accent-soft);
		}
		@media (max-width: 480px) {
			.player-wrap[data-radio-mode="on"] {
				flex-direction: column;
				padding: 1rem;
			}
		}

		/* Collapsed mobile EPG shows only the now-playing row; status text (loading/empty/error) stays visible.
		   :global() because #epg-list children are inserted at runtime without Astro's scope attribute. */
		@media (max-width: 767.98px), (max-width: 1023.98px) and (orientation: portrait) {
			:global(#epg[data-epg-collapsed="true"] #epg-list > :is([data-epg-idx]:not([data-now-playing="true"]), .epg-day-sep, [data-epg-load-earlier])) {
				display: none;
			}
		}
	</style>

	<script>
		import "../scripts/stream/stream.ts";
		import "../scripts/updater-startup.js";

		const playerEl = document.getElementById("player");
		const playerEmpty = document.getElementById("player-empty");
		if (playerEl && playerEmpty) {
			const sync = () => {
				playerEmpty.style.display = playerEl.hasAttribute("hidden") ? "" : "none";
			};
			sync();
			new MutationObserver(sync).observe(playerEl, {
				attributes: true,
				attributeFilter: ["hidden"],
			});
		}

		const epgToggle = /** @type {HTMLButtonElement|null} */ (
			document.getElementById("epg-toggle")
		);
		const epgPanel = document.getElementById("epg");
		if (epgToggle && epgPanel) {
			const KEY_VISIBLE = "xt_epg_visible";
			const KEY_DEFAULT = "xt_epg_open_default";

			const readDefault = () => {
				try {
					const v = localStorage.getItem(KEY_DEFAULT);
					return v === null ? true : v === "true";
				} catch {
					return true;
				}
			};
			const readVisible = () => {
				try {
					const v = localStorage.getItem(KEY_VISIBLE);
					return v === null ? readDefault() : v === "true";
				} catch {
					return true;
				}
			};

			const apply = (visible) => {
				epgPanel.classList.toggle("hidden", !visible);
				epgToggle.setAttribute("aria-pressed", String(visible));
			};

			apply(readVisible());

			epgToggle.addEventListener("click", () => {
				const next = epgToggle.getAttribute("aria-pressed") !== "true";
				try {
					localStorage.setItem(KEY_VISIBLE, String(next));
				} catch {}
				apply(next);
			});
		}

		const epgExpandToggle = /** @type {HTMLButtonElement|null} */ (
			document.getElementById("epg-expand-toggle")
		);
		if (epgExpandToggle && epgPanel) {
			const KEY_LIST_EXPANDED = "xt_epg_list_expanded";

			const readListExpanded = () => {
				try {
					return localStorage.getItem(KEY_LIST_EXPANDED) === "1";
				} catch {
					return false;
				}
			};

			const applyListExpanded = (expanded) => {
				epgPanel.setAttribute("data-epg-collapsed", expanded ? "false" : "true");
				epgExpandToggle.setAttribute("aria-expanded", String(expanded));
				const label = expanded
					? epgExpandToggle.dataset.labelCollapse
					: epgExpandToggle.dataset.labelExpand;
				if (label) epgExpandToggle.setAttribute("aria-label", label);
			};

			applyListExpanded(readListExpanded());

			epgExpandToggle.addEventListener("click", () => {
				const next = epgExpandToggle.getAttribute("aria-expanded") !== "true";
				try {
					localStorage.setItem(KEY_LIST_EXPANDED, next ? "1" : "0");
				} catch {}
				applyListExpanded(next);
			});
		}
	</script>
</Layout>
