  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  tv: '<rect x="3" y="5" width="18" height="13" rx="2.5"/><path d="M8 21h8"/><path d="M12 18v3"/>',
  brand: '<path d="M65.6 70.2 A50 50 0 1 1 20.2 115.6" stroke-width="20"/><circle cx="34.6" cy="84.6" r="9" fill="currentColor" stroke="none"/><circle cx="170" cy="120" r="50" stroke-width="20"/><rect x="146.5" y="94" width="13" height="52" rx="6.5" fill="currentColor" stroke="none"/><rect x="164.5" y="102" width="13" height="36" rx="6.5" fill="currentColor" stroke="none"/><rect x="182.5" y="110" width="13" height="20" rx="6.5" fill="currentColor" stroke="none"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>',
  subtitles: '<path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/><path d="M10 10.5a1.5 1.5 0 0 0-3 0v3a1.5 1.5 0 0 0 3 0M17 10.5a1.5 1.5 0 0 0-3 0v3a1.5 1.5 0 0 0 3 0"/>',
  volume: '<path d="M15 8a5 5 0 0 1 0 8M17.7 5a9 9 0 0 1 0 14"/><path d="M6 15H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h2l3.5-4.5A.8.8 0 0 1 11 5v14a.8.8 0 0 1-1.5.5L6 15Z"/>',
  language: '<path d="M4 5h7M9 3v2c0 4.4-2.7 7.9-6 9M5 9c0 2.1 2.8 4.4 6 5M12 20l4-9 4 9M19.1 18h-6.2"/>',
} as const

const VIEWBOXES: Partial<Record<keyof typeof ICONS, string>> = {
  brand: "8 58 224 124",
}

export type IconName = keyof typeof ICONS

interface Props {
  name: IconName
  class?: string
}

const { name, class: className = "h-5 w-5" } = Astro.props
const body = ICONS[name]
const viewBox = VIEWBOXES[name] ?? "0 0 24 24"
---

<svg
  class={className}
  viewBox={viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={body}
/>
