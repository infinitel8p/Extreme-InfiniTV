<?xml version="1.0" encoding="utf-8"?>
<!--
  Native VideoActivity layout.
  - player_view: Media3 PlayerView, fills the screen.
  - channel_list_overlay: bottom-aligned RecyclerView, ~40% screen height,
    slides up from the bottom on D-pad up. Hidden by default; gone in
    PiP and in VOD mode.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true"
        app:auto_show="true"
        app:hide_on_touch="true" />

    <LinearLayout
        android:id="@+id/channel_list_overlay"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/xt_overlay_scrim"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/channel_list_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/xt_row_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:paddingBottom="8dp"
            android:text="Channels" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channel_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
